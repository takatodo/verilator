compute_object_cache_key() {
  local compiler_id="$1"
  local flags="$2"
  local src="$3"
  {
    printf 'compiler=%s\n' "$compiler_id"
    printf 'flags=%s\n' "$flags"
    printf 'src=%s\n' "$(basename "$src")"
    printf 'sha=%s\n' "$(sha256_one "$src")"
  } | sha256sum | awk '{print $1}'
}

build_cached_cuda_object() {
  local src="$1"
  local out_obj="$2"
  local extra_flags="${3:-}"
  local compile_flags="-O3 -std=c++17 -c"
  if [[ -n "$extra_flags" ]]; then
    compile_flags+=" $extra_flags"
  fi
  local key compiler_id cache_obj tmp_obj namespace
  compiler_id="$(nvcc --version | tr '\n' '|')"
  key="$(compute_object_cache_key "$compiler_id" "$compile_flags" "$src")"
  namespace="$(partition_object_namespace "$src")"
  cache_obj="$COMPILE_CACHE_DIR/object-cache/$namespace/$key.o"
  if [[ -f "$cache_obj" ]]; then
    cp "$cache_obj" "$out_obj"
    OBJECT_CACHE_HITS=$((OBJECT_CACHE_HITS + 1))
    return 0
  fi
  nvcc -O3 -std=c++17 -c $extra_flags "$src" -o "$out_obj"
  tmp_obj="$COMPILE_CACHE_DIR/.tmp.object.$key.$$"
  mkdir -p "$(dirname "$cache_obj")"
  cp "$out_obj" "$tmp_obj"
  if ! mv "$tmp_obj" "$cache_obj" 2>/dev/null; then
    rm -f "$tmp_obj"
  fi
  OBJECT_CACHE_MISSES=$((OBJECT_CACHE_MISSES + 1))
}

build_cached_cxx_object() {
  local src="$1"
  local out_obj="$2"
  local extra_flags="${3:-}"
  local compile_flags="-O3 -std=c++17 -c"
  if [[ -n "$extra_flags" ]]; then
    compile_flags+=" $extra_flags"
  fi
  local key compiler_id cache_obj tmp_obj namespace
  compiler_id="$(g++ --version | tr '\n' '|')"
  key="$(compute_object_cache_key "$compiler_id" "$compile_flags" "$src")"
  namespace="$(partition_object_namespace "$src")"
  cache_obj="$COMPILE_CACHE_DIR/object-cache/$namespace/$key.o"
  if [[ -f "$cache_obj" ]]; then
    cp "$cache_obj" "$out_obj"
    OBJECT_CACHE_HITS=$((OBJECT_CACHE_HITS + 1))
    return 0
  fi
  g++ -O3 -std=c++17 -c $extra_flags "$src" -o "$out_obj"
  tmp_obj="$COMPILE_CACHE_DIR/.tmp.object.$key.$$"
  mkdir -p "$(dirname "$cache_obj")"
  cp "$out_obj" "$tmp_obj"
  if ! mv "$tmp_obj" "$cache_obj" 2>/dev/null; then
    rm -f "$tmp_obj"
  fi
  OBJECT_CACHE_MISSES=$((OBJECT_CACHE_MISSES + 1))
}

