static void checkCuda(cudaError_t st, const char* msg) {
  if (st != cudaSuccess) {
    std::cerr << "CUDA error at " << msg << ": " << cudaGetErrorString(st) << "\n";
    std::exit(2);
  }
}

static std::vector<std::string> splitTabs(const std::string& s) {
  std::vector<std::string> out;
  std::string token;
  std::stringstream ss(s);
  while (std::getline(ss, token, '\t')) out.push_back(token);
  return out;
}

static bool parseU64(const std::string& s, uint64_t* out) {
  if (s.empty()) return false;
  errno = 0;
  char* endp = nullptr;
  const unsigned long long v = std::strtoull(s.c_str(), &endp, 0);
  if (errno != 0 || endp == s.c_str() || *endp != '\0') return false;
  *out = static_cast<uint64_t>(v);
  return true;
}

static bool parseCommaSeparatedU32s(const std::string& s, std::vector<uint32_t>* outp) {
  outp->clear();
  if (s.empty()) return false;
  std::stringstream ss(s);
  std::string token;
  while (std::getline(ss, token, ',')) {
    uint64_t raw = 0;
    if (!parseU64(token, &raw) || raw > 0xffffffffULL) return false;
    outp->push_back(static_cast<uint32_t>(raw));
  }
  return !outp->empty();
}

static std::string joinU32Csv(const std::vector<uint32_t>& values) {
  std::ostringstream os;
  for (size_t i = 0; i < values.size(); ++i) {
    if (i) os << ",";
    os << values[i];
  }
  return os.str();
}

static uint32_t maskToWidth(uint64_t value, uint32_t width) {
  if (width == 0) return 0;
  if (width >= 32) return static_cast<uint32_t>(value);
  const uint64_t mask = (uint64_t{1} << width) - 1;
  return static_cast<uint32_t>(value & mask);
}

struct InitFileStats {
  size_t rules_applied = 0;
  size_t values_applied = 0;
  size_t lines_ignored = 0;
};

struct HybridTimingStats {
  double cpu_dispatch_ms = 0.0;
  double dynamic_h2d_ms = 0.0;
  double kernel_ms = 0.0;
  double d2h_ms = 0.0;
};

static std::vector<uint32_t> loadVarWidths(const std::string& varsPath, uint32_t nvars) {
  std::vector<uint32_t> widths(nvars, 32);
  std::ifstream vf(varsPath);
  if (!vf) return widths;
  std::string line;
  bool first = true;
  while (std::getline(vf, line)) {
    if (first) {
      first = false;
      continue;
    }
    if (line.empty()) continue;
    const auto cols = splitTabs(line);
    if (cols.size() < 6) continue;
    uint64_t idxRaw = 0;
    uint64_t widthRaw = 0;
    if (!parseU64(cols[0], &idxRaw)) continue;
    if (!parseU64(cols[5], &widthRaw)) continue;
    if (idxRaw >= widths.size()) continue;
    uint32_t width = static_cast<uint32_t>(widthRaw);
    if (width == 0) width = 1;
    if (width > 32) width = 32;
    widths[idxRaw] = width;
  }
  return widths;
}

static std::vector<uint32_t> loadCommVarIdxs(uint32_t (*countFn)(), uint32_t (*indexFn)(uint32_t)) {
  const uint32_t count = countFn();
  std::vector<uint32_t> out(count, 0);
  for (uint32_t i = 0; i < count; ++i) out[i] = indexFn(i);
  return out;
}

static std::vector<uint32_t> loadPartitionVarIdxs(uint32_t partitionIndex,
                                                  uint32_t (*countFn)(uint32_t),
                                                  uint32_t (*indexFn)(uint32_t, uint32_t)) {
  const uint32_t count = countFn(partitionIndex);
  std::vector<uint32_t> out(count, 0);
  for (uint32_t i = 0; i < count; ++i) out[i] = indexFn(partitionIndex, i);
  return out;
}

static std::vector<uint32_t> subtractOrderedVarIdxs(const std::vector<uint32_t>& allVarIdxs,
                                                    const std::vector<uint32_t>& removedVarIdxs,
                                                    uint32_t nvars) {
  std::vector<uint8_t> removed(nvars, 0);
  for (const uint32_t varIdx : removedVarIdxs) {
    if (varIdx < nvars) removed[varIdx] = 1;
  }
  std::vector<uint32_t> out;
  out.reserve(allVarIdxs.size());
  for (const uint32_t varIdx : allVarIdxs) {
    if (varIdx >= nvars || !removed[varIdx]) out.push_back(varIdx);
  }
  return out;
}

static std::vector<uint32_t> unionOrderedVarIdxLists(
    const std::vector<std::vector<uint32_t>>& varIdxLists, uint32_t nvars) {
  std::vector<uint8_t> seen(nvars, 0);
  std::vector<uint32_t> out;
  for (const auto& varIdxs : varIdxLists) {
    for (const uint32_t varIdx : varIdxs) {
      if (varIdx >= nvars || seen[varIdx]) continue;
      seen[varIdx] = 1;
      out.push_back(varIdx);
    }
  }
  return out;
}

static std::vector<uint32_t> filterOrderedVarIdxsByMask(const std::vector<uint32_t>& varIdxs,
                                                        const std::vector<uint8_t>& keepMask) {
  std::vector<uint32_t> out;
  out.reserve(varIdxs.size());
  for (const uint32_t varIdx : varIdxs) {
    if (varIdx < keepMask.size() && keepMask[varIdx]) out.push_back(varIdx);
  }
  return out;
}

static size_t logicalBytesPerBatch(const std::vector<uint32_t>& varIdxs,
                                   const std::vector<uint32_t>& widths, uint32_t nstates) {
  size_t perStateBytes = 0;
  for (uint32_t varIdx : varIdxs) {
    const uint32_t width = (varIdx < widths.size()) ? widths[varIdx] : 32U;
    perStateBytes += (static_cast<size_t>(width) + 7u) / 8u;
  }
  return perStateBytes * static_cast<size_t>(nstates);
}

static std::vector<uint32_t> gatherSlotsVarMajor(const std::vector<uint32_t>& stateVarMajor,
                                                 const std::vector<uint32_t>& varIdxs,
                                                 uint32_t nstates) {
  std::vector<uint32_t> out(static_cast<size_t>(varIdxs.size()) * nstates, 0u);
  for (size_t slot = 0; slot < varIdxs.size(); ++slot) {
    const size_t srcBase = static_cast<size_t>(varIdxs[slot]) * nstates;
    const size_t dstBase = slot * static_cast<size_t>(nstates);
    std::copy_n(stateVarMajor.begin() + srcBase, nstates, out.begin() + dstBase);
  }
  return out;
}

static void gatherSlotsVarMajorInto(const std::vector<uint32_t>& stateVarMajor,
                                    const std::vector<uint32_t>& varIdxs, uint32_t nstates,
                                    std::vector<uint32_t>* outp) {
  outp->resize(static_cast<size_t>(varIdxs.size()) * nstates, 0u);
  for (size_t slot = 0; slot < varIdxs.size(); ++slot) {
    const size_t srcBase = static_cast<size_t>(varIdxs[slot]) * nstates;
    const size_t dstBase = slot * static_cast<size_t>(nstates);
    std::copy_n(stateVarMajor.begin() + srcBase, nstates, outp->begin() + dstBase);
  }
}

static void scatterSlotsVarMajor(std::vector<uint32_t>& stateVarMajor,
                                 const std::vector<uint32_t>& compactSlots,
                                 const std::vector<uint32_t>& varIdxs, uint32_t nstates) {
  for (size_t slot = 0; slot < varIdxs.size(); ++slot) {
    const size_t srcBase = slot * static_cast<size_t>(nstates);
    const size_t dstBase = static_cast<size_t>(varIdxs[slot]) * nstates;
    std::copy_n(compactSlots.begin() + srcBase, nstates, stateVarMajor.begin() + dstBase);
  }
}

static size_t compactTransferBytes(const std::vector<uint32_t>& varIdxs, uint32_t nstates) {
  return static_cast<size_t>(varIdxs.size()) * nstates * sizeof(uint32_t);
}

static void applyInitMode(std::vector<uint32_t>& h_in, uint32_t nvars, uint32_t nstates,
                          const std::string& mode, uint32_t seed) {
  const size_t elems = static_cast<size_t>(nvars) * nstates;
  if (mode == "zero") {
    std::fill(h_in.begin(), h_in.end(), 0u);
    return;
  }
  if (mode == "ones") {
    std::fill(h_in.begin(), h_in.end(), 0xffffffffu);
    return;
  }
  if (mode == "counter") {
    for (uint32_t idx = 0; idx < nvars; ++idx) {
      const size_t base = static_cast<size_t>(idx) * nstates;
      for (uint32_t tid = 0; tid < nstates; ++tid) {
        h_in[base + tid] = static_cast<uint32_t>((idx * 2654435761u) ^ tid);
      }
    }
    return;
  }
  std::mt19937 rng(seed);
  std::uniform_int_distribution<uint32_t> dist(0, 0xffffffffu);
  for (size_t i = 0; i < elems; ++i) h_in[i] = dist(rng);
}

static InitFileStats applyInitFile(std::vector<uint32_t>& h_in, uint32_t nvars, uint32_t nstates,
                                   const std::string& varsPath,
                                   const std::string& initPath) {
  InitFileStats stats;
  std::vector<uint32_t> widths(nvars, 32);
  std::unordered_map<std::string, uint32_t> nameToIndex;

  {
    std::ifstream vf(varsPath);
    if (!vf) {
      std::cerr << "Warning: could not open vars TSV for name-based init: " << varsPath << "\n";
    } else {
      std::string line;
      bool first = true;
      while (std::getline(vf, line)) {
        if (first) {
          first = false;
          continue;
        }
        if (line.empty()) continue;
        const auto cols = splitTabs(line);
        if (cols.size() < 6) continue;
        uint64_t idx = 0;
        uint64_t width = 0;
        if (!parseU64(cols[0], &idx)) continue;
        if (idx >= nvars) continue;
        if (parseU64(cols[5], &width)) widths[idx] = static_cast<uint32_t>(width);
        nameToIndex[cols[1]] = static_cast<uint32_t>(idx);
      }
    }
  }

  std::ifstream inf(initPath);
  if (!inf) {
    std::cerr << "Warning: could not open init file: " << initPath << "\n";
    return stats;
  }

  std::string line;
  while (std::getline(inf, line)) {
    const auto hashPos = line.find('#');
    if (hashPos != std::string::npos) line.resize(hashPos);
    for (char& ch : line) {
      if (ch == ',' || ch == '\t') ch = ' ';
    }

    std::vector<std::string> toks;
    {
      std::stringstream ss(line);
      std::string tok;
      while (ss >> tok) toks.push_back(tok);
    }
    if (toks.empty()) continue;
    if (toks.size() != 2 && toks.size() != 3) {
      ++stats.lines_ignored;
      continue;
    }

    uint32_t varIdx = 0;
    {
      uint64_t idxParsed = 0;
      if (parseU64(toks[0], &idxParsed)) {
        if (idxParsed >= nvars) {
          ++stats.lines_ignored;
          continue;
        }
        varIdx = static_cast<uint32_t>(idxParsed);
      } else {
        const auto it = nameToIndex.find(toks[0]);
        if (it == nameToIndex.end()) {
          ++stats.lines_ignored;
          continue;
        }
        varIdx = it->second;
      }
    }

    uint64_t valueRaw = 0;
    if (!parseU64(toks.back(), &valueRaw)) {
      ++stats.lines_ignored;
      continue;
    }
    const uint32_t value = maskToWidth(valueRaw, widths[varIdx]);

    const size_t base = static_cast<size_t>(varIdx) * nstates;
    if (toks.size() == 2) {
      for (uint32_t tid = 0; tid < nstates; ++tid) h_in[base + tid] = value;
      ++stats.rules_applied;
      stats.values_applied += nstates;
      continue;
    }

    uint64_t stateIdxRaw = 0;
    if (!parseU64(toks[1], &stateIdxRaw) || stateIdxRaw >= nstates) {
      ++stats.lines_ignored;
      continue;
    }
    h_in[base + static_cast<size_t>(stateIdxRaw)] = value;
    ++stats.rules_applied;
    ++stats.values_applied;
  }

  return stats;
}

#ifndef SIM_ACCEL_SKIP_CPU_REFERENCE_BUILD
static void sim_accel_eval_assignw_cpu(const uint32_t* state_in, uint32_t* state_out,
                                       uint32_t nstates) {
  sim_accel_eval_assignw_cpu_ref(state_in, state_out, nstates);
}
#endif

static size_t chunkedIndex(uint32_t varIdx, uint32_t stateIdx, uint32_t nvars, uint32_t stateChunk) {
  const uint32_t chunkId = stateIdx / stateChunk;
  const uint32_t local = stateIdx % stateChunk;
  const size_t chunkBase = static_cast<size_t>(chunkId) * static_cast<size_t>(nvars) * stateChunk;
  return chunkBase + static_cast<size_t>(varIdx) * stateChunk + local;
}

__host__ __device__ static size_t simAccelLinearIndex(uint32_t varIdx, uint32_t stateIdx,
                                                      uint32_t nvars, uint32_t nstates,
                                                      uint32_t stateChunk) {
  if (stateChunk == 0 || stateChunk >= nstates) {
    return static_cast<size_t>(varIdx) * nstates + stateIdx;
  }
  const uint32_t chunkId = stateIdx / stateChunk;
  const uint32_t local = stateIdx % stateChunk;
  const size_t chunkBase = static_cast<size_t>(chunkId) * static_cast<size_t>(nvars) * stateChunk;
  return chunkBase + static_cast<size_t>(varIdx) * stateChunk + local;
}

__global__ void sim_accel_scatter_inputs_u32(const uint32_t* compactIn, const uint32_t* inputVarIdxs,
                                             uint32_t ninputVars, uint32_t* stateFull,
                                             uint32_t nvars, uint32_t nstates,
                                             uint32_t stateChunk) {
  const uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;
  if (tid >= nstates) return;
  for (uint32_t slot = 0; slot < ninputVars; ++slot) {
    const uint32_t varIdx = inputVarIdxs[slot];
    const size_t src = static_cast<size_t>(slot) * nstates + tid;
    const size_t dst = simAccelLinearIndex(varIdx, tid, nvars, nstates, stateChunk);
    stateFull[dst] = compactIn[src];
  }
}

__global__ void sim_accel_gather_outputs_u32(const uint32_t* stateFull, const uint32_t* outputVarIdxs,
                                             uint32_t noutputVars, uint32_t* compactOut,
                                             uint32_t nvars, uint32_t nstates,
                                             uint32_t stateChunk) {
  const uint32_t tid = blockIdx.x * blockDim.x + threadIdx.x;
  if (tid >= nstates) return;
  for (uint32_t slot = 0; slot < noutputVars; ++slot) {
    const uint32_t varIdx = outputVarIdxs[slot];
    const size_t src = simAccelLinearIndex(varIdx, tid, nvars, nstates, stateChunk);
    const size_t dst = static_cast<size_t>(slot) * nstates + tid;
    compactOut[dst] = stateFull[src];
  }
}

static std::vector<uint32_t> unchunkToVarMajor(const std::vector<uint32_t>& chunked, uint32_t nvars,
                                               uint32_t nstates, uint32_t stateChunk) {
  std::vector<uint32_t> out(static_cast<size_t>(nvars) * nstates, 0u);
  for (uint32_t varIdx = 0; varIdx < nvars; ++varIdx) {
    for (uint32_t stateIdx = 0; stateIdx < nstates; ++stateIdx) {
      const size_t dst = static_cast<size_t>(varIdx) * nstates + stateIdx;
      const size_t src = chunkedIndex(varIdx, stateIdx, nvars, stateChunk);
      out[dst] = chunked[src];
    }
  }
  return out;
}

static void printUsageAndExit(const char* argv0) {
  std::cerr << "Usage: " << argv0
              << " [--init-mode random|zero|ones|counter] [--init-seed N] [--init-file PATH]"
            << " --nstates N --gpu-reps N --cpu-reps N"
            << " [--state-chunk N] [--block-size N]"
            << " [--hybrid-mode off|single-partition|single-cluster|cluster-group]"
            << " [--hybrid-partition-index N] [--hybrid-cluster-index N]"
            << " [--hybrid-cluster-indices I,J,...]"
            << " [--hybrid-cluster-auto] [--hybrid-cluster-auto-max-input-bits N]\n";
  std::exit(2);
}

static bool betterAutoHybridCluster(uint32_t clusterIdx, uint32_t assignCount, uint64_t inputBits,
                                    uint32_t bestCluster, uint32_t bestAssignCount,
                                    uint64_t bestInputBits) {
  return assignCount > bestAssignCount
         || (assignCount == bestAssignCount && inputBits < bestInputBits)
         || (assignCount == bestAssignCount && inputBits == bestInputBits
             && clusterIdx < bestCluster);
}

static bool selectAutoHybridCluster(uint32_t clusterCount, uint64_t maxInputBits,
                                    uint32_t* selectedClusterp, uint32_t* candidateCountp,
                                    std::string* selectedOwnerHintp, bool* fallbackUsedp) {
  bool foundPreferred = false;
  uint32_t bestPreferredCluster = 0;
  uint32_t bestPreferredAssignCount = 0;
  uint64_t bestPreferredInputBits = 0;
  uint32_t preferredCandidateCount = 0;

  bool foundFallback = false;
  uint32_t bestFallbackCluster = 0;
  uint32_t bestFallbackAssignCount = 0;
  uint64_t bestFallbackInputBits = 0;
  uint32_t fallbackCandidateCount = 0;

  for (uint32_t clusterIdx = 0; clusterIdx < clusterCount; ++clusterIdx) {
    const std::string ownerHint = sim_accel_eval_cluster_owner_hint(clusterIdx);
    const uint64_t inputBits = sim_accel_eval_cluster_input_signature_bits(clusterIdx);
    const uint32_t assignCount = sim_accel_eval_cluster_assign_count(clusterIdx);
    if (inputBits > maxInputBits) continue;
    if (assignCount == 0) continue;

    if (ownerHint == "gpu_candidate") {
      ++preferredCandidateCount;
      if (!foundPreferred || betterAutoHybridCluster(clusterIdx, assignCount, inputBits,
                                                     bestPreferredCluster,
                                                     bestPreferredAssignCount,
                                                     bestPreferredInputBits)) {
        foundPreferred = true;
        bestPreferredCluster = clusterIdx;
        bestPreferredAssignCount = assignCount;
        bestPreferredInputBits = inputBits;
      }
    } else if (ownerHint == "cpu_boundary_heavy") {
      ++fallbackCandidateCount;
      if (!foundFallback || betterAutoHybridCluster(clusterIdx, assignCount, inputBits,
                                                    bestFallbackCluster,
                                                    bestFallbackAssignCount,
                                                    bestFallbackInputBits)) {
        foundFallback = true;
        bestFallbackCluster = clusterIdx;
        bestFallbackAssignCount = assignCount;
        bestFallbackInputBits = inputBits;
      }
    }
  }
  if (candidateCountp) *candidateCountp = preferredCandidateCount + fallbackCandidateCount;
  if (selectedOwnerHintp) *selectedOwnerHintp = "";
  if (fallbackUsedp) *fallbackUsedp = false;
  if (foundPreferred) {
    *selectedClusterp = bestPreferredCluster;
    if (selectedOwnerHintp) *selectedOwnerHintp = "gpu_candidate";
    return true;
  }
  if (foundFallback) {
    *selectedClusterp = bestFallbackCluster;
    if (selectedOwnerHintp) *selectedOwnerHintp = "cpu_boundary_heavy";
    if (fallbackUsedp) *fallbackUsedp = true;
    return true;
  }
  return false;
}

int main(int argc, char** argv) {
  std::string initMode = "random";
  uint32_t initSeed = 1;
  std::string initFile;
  uint32_t nstates = 0;
  int gpu_reps = 0;
  int cpu_reps = 0;
  uint32_t stateChunk = 0;
  uint32_t blockSize = 256;
  std::string hybridMode = "off";
  bool hybridPartitionIndexSet = false;
  uint32_t hybridPartitionIndex = 0;
  bool hybridClusterIndexSet = false;
  uint32_t hybridClusterIndex = 0;
  bool hybridClusterIndicesSet = false;
  std::string hybridClusterIndicesCsv;
  std::vector<uint32_t> hybridClusterIndices;
  bool hybridClusterAuto = false;
  uint64_t hybridClusterAutoMaxInputBits = 128;
  bool hybridClusterAutoFallbackUsed = false;
  std::string hybridClusterAutoSelectedOwnerHint;

  for (int i = 1; i < argc; ++i) {
    const std::string a = argv[i];
    if (a == "--init-mode") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      initMode = argv[++i];
    } else if (a == "--init-seed") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t seed = 0;
      if (!parseU64(argv[++i], &seed)) printUsageAndExit(argv[0]);
      initSeed = static_cast<uint32_t>(seed);
    } else if (a == "--init-file") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      initFile = argv[++i];
    } else if (a == "--nstates") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t raw = 0;
      if (!parseU64(argv[++i], &raw) || raw == 0 || raw > 0xffffffffULL) printUsageAndExit(argv[0]);
      nstates = static_cast<uint32_t>(raw);
    } else if (a == "--gpu-reps") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t raw = 0;
      if (!parseU64(argv[++i], &raw) || raw == 0 || raw > 0x7fffffffULL) printUsageAndExit(argv[0]);
      gpu_reps = static_cast<int>(raw);
    } else if (a == "--cpu-reps") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t raw = 0;
      if (!parseU64(argv[++i], &raw) || raw == 0 || raw > 0x7fffffffULL) printUsageAndExit(argv[0]);
      cpu_reps = static_cast<int>(raw);
    } else if (a == "--state-chunk") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t chunk = 0;
      if (!parseU64(argv[++i], &chunk)) printUsageAndExit(argv[0]);
      stateChunk = static_cast<uint32_t>(chunk);
    } else if (a == "--block-size") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t bs = 0;
      if (!parseU64(argv[++i], &bs) || bs == 0 || bs > 1024) printUsageAndExit(argv[0]);
      blockSize = static_cast<uint32_t>(bs);
    } else if (a == "--hybrid-mode") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      hybridMode = argv[++i];
    } else if (a == "--hybrid-partition-index") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t raw = 0;
      if (!parseU64(argv[++i], &raw) || raw > 0xffffffffULL) printUsageAndExit(argv[0]);
      hybridPartitionIndex = static_cast<uint32_t>(raw);
      hybridPartitionIndexSet = true;
    } else if (a == "--hybrid-cluster-index") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t raw = 0;
      if (!parseU64(argv[++i], &raw) || raw > 0xffffffffULL) printUsageAndExit(argv[0]);
      hybridClusterIndex = static_cast<uint32_t>(raw);
      hybridClusterIndexSet = true;
    } else if (a == "--hybrid-cluster-indices") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      hybridClusterIndicesCsv = argv[++i];
      if (!parseCommaSeparatedU32s(hybridClusterIndicesCsv, &hybridClusterIndices)) {
        printUsageAndExit(argv[0]);
      }
      hybridClusterIndicesSet = true;
    } else if (a == "--hybrid-cluster-auto") {
      hybridClusterAuto = true;
    } else if (a == "--hybrid-cluster-auto-max-input-bits") {
      if (i + 1 >= argc) printUsageAndExit(argv[0]);
      uint64_t raw = 0;
      if (!parseU64(argv[++i], &raw)) printUsageAndExit(argv[0]);
      hybridClusterAutoMaxInputBits = raw;
    } else {
      printUsageAndExit(argv[0]);
    }
  }

  if (initMode != "random" && initMode != "zero" && initMode != "ones" && initMode != "counter") {
    std::cerr << "Invalid --init-mode: " << initMode << "\n";
    return 2;
  }
  if (nstates == 0 || gpu_reps <= 0 || cpu_reps <= 0) printUsageAndExit(argv[0]);
  if (hybridMode != "off" && hybridMode != "single-partition" && hybridMode != "single-cluster"
      && hybridMode != "cluster-group") {
    std::cerr << "Invalid --hybrid-mode: " << hybridMode << "\n";
    return 2;
  }
  if (hybridMode == "single-partition" && !hybridPartitionIndexSet) {
    std::cerr << "--hybrid-partition-index is required with --hybrid-mode single-partition\n";
    return 2;
  }
  if (hybridMode == "single-cluster" && hybridClusterIndexSet && hybridClusterAuto) {
    std::cerr << "--hybrid-cluster-index and --hybrid-cluster-auto are mutually exclusive\n";
    return 2;
  }
  if (hybridMode == "single-cluster" && hybridClusterIndicesSet) {
    std::cerr << "--hybrid-cluster-indices requires --hybrid-mode cluster-group\n";
    return 2;
  }
  if (hybridMode == "single-cluster" && !hybridClusterIndexSet && !hybridClusterAuto) {
    std::cerr << "--hybrid-cluster-index or --hybrid-cluster-auto is required with --hybrid-mode single-cluster\n";
    return 2;
  }
  if (hybridMode == "cluster-group" && !hybridClusterIndicesSet) {
    std::cerr << "--hybrid-cluster-indices is required with --hybrid-mode cluster-group\n";
    return 2;
  }
  if (hybridMode != "single-partition" && hybridPartitionIndexSet) {
    std::cerr << "--hybrid-partition-index requires --hybrid-mode single-partition\n";
    return 2;
  }
  if (hybridMode != "single-cluster" && hybridClusterIndexSet) {
    std::cerr << "--hybrid-cluster-index requires --hybrid-mode single-cluster\n";
    return 2;
  }
  if (hybridMode != "cluster-group" && hybridClusterIndicesSet) {
    std::cerr << "--hybrid-cluster-indices requires --hybrid-mode cluster-group\n";
    return 2;
  }
  if (hybridMode != "single-cluster" && hybridClusterAuto) {
    std::cerr << "--hybrid-cluster-auto requires --hybrid-mode single-cluster\n";
    return 2;
  }
  if (!hybridClusterAuto && hybridClusterAutoMaxInputBits != 128) {
    std::cerr << "--hybrid-cluster-auto-max-input-bits requires --hybrid-cluster-auto\n";
    return 2;
  }

  const uint32_t nvars = sim_accel_eval_var_count();
  const uint32_t partitionCount = sim_accel_eval_partition_count();
  const uint32_t clusterCount = sim_accel_eval_cluster_count();
  uint32_t hybridClusterAutoCandidateCount = 0;
  if (hybridMode == "single-cluster" && hybridClusterAuto) {
    if (!selectAutoHybridCluster(clusterCount, hybridClusterAutoMaxInputBits, &hybridClusterIndex,
                                 &hybridClusterAutoCandidateCount,
                                 &hybridClusterAutoSelectedOwnerHint,
                                 &hybridClusterAutoFallbackUsed)) {
      std::cerr << "No suitable hybrid cluster found for auto-selection"
                << " (max_input_bits=" << hybridClusterAutoMaxInputBits << ")\n";
      return 2;
    }
    hybridClusterIndexSet = true;
  }
  if (hybridMode == "single-partition" && hybridPartitionIndex >= partitionCount) {
    std::cerr << "Invalid --hybrid-partition-index: " << hybridPartitionIndex
              << " (partition_count=" << partitionCount << ")\n";
    return 2;
  }
  if (hybridMode == "single-cluster" && hybridClusterIndex >= clusterCount) {
    std::cerr << "Invalid --hybrid-cluster-index: " << hybridClusterIndex
              << " (cluster_count=" << clusterCount << ")\n";
    return 2;
  }
  if (hybridMode == "cluster-group") {
    std::vector<uint8_t> seenCluster(clusterCount, 0);
    for (uint32_t clusterIdx : hybridClusterIndices) {
      if (clusterIdx >= clusterCount) {
        std::cerr << "Invalid --hybrid-cluster-indices entry: " << clusterIdx
                  << " (cluster_count=" << clusterCount << ")\n";
        return 2;
      }
      if (seenCluster[clusterIdx]) {
        std::cerr << "Duplicate cluster index in --hybrid-cluster-indices: " << clusterIdx << "\n";
        return 2;
      }
      seenCluster[clusterIdx] = 1;
      if (sim_accel_eval_cluster_assign_count(clusterIdx) == 0) {
        std::cerr << "Selected hybrid cluster has no emitted assigns: " << clusterIdx << "\n";
        return 2;
      }
    }
    std::sort(hybridClusterIndices.begin(), hybridClusterIndices.end());
    hybridClusterIndicesCsv = joinU32Csv(hybridClusterIndices);
  }
  if (hybridMode == "single-cluster"
      && sim_accel_eval_cluster_assign_count(hybridClusterIndex) == 0) {
    std::cerr << "Selected hybrid cluster has no emitted assigns: " << hybridClusterIndex << "\n";
    return 2;
  }
  const std::vector<uint32_t> inputVarIdxs
      = loadCommVarIdxs(sim_accel_eval_input_count, sim_accel_eval_input_var_index);
  const std::vector<uint32_t> outputVarIdxs
      = loadCommVarIdxs(sim_accel_eval_output_count, sim_accel_eval_output_var_index);
  const std::vector<uint32_t> clusterTopoOrder
      = loadCommVarIdxs(sim_accel_eval_cluster_topo_count, sim_accel_eval_cluster_topo_index);
  if (stateChunk > nstates) stateChunk = nstates;
  const bool useChunkLayout = (stateChunk > 0 && stateChunk < nstates);
  if (hybridMode != "off" && useChunkLayout) {
    std::cerr << "Hybrid mode is not supported with --state-chunk in this prototype\n";
    return 2;
  }
  const uint32_t nchunks = useChunkLayout ? ((nstates + stateChunk - 1) / stateChunk) : 1;
  const uint32_t paddedStates = useChunkLayout ? (nchunks * stateChunk) : nstates;

  const size_t elems = static_cast<size_t>(nvars) * nstates;
  const size_t elemsAlloc = static_cast<size_t>(nvars) * paddedStates;
  const size_t bytes = elemsAlloc * sizeof(uint32_t);
  const size_t compactInputElems = static_cast<size_t>(inputVarIdxs.size()) * nstates;
  const size_t compactOutputElems = static_cast<size_t>(outputVarIdxs.size()) * nstates;
  const size_t compactInputBytes = compactInputElems * sizeof(uint32_t);
  const size_t compactOutputBytes = compactOutputElems * sizeof(uint32_t);
  const size_t compactRoundtripBytes = compactInputBytes + compactOutputBytes;
  const size_t fullRoundtripBytes = elems * sizeof(uint32_t) * 2u;
  const size_t commIndexBytes = (inputVarIdxs.size() + outputVarIdxs.size()) * sizeof(uint32_t);

  std::vector<uint32_t> h_seed_varmajor(elems);
  std::vector<uint32_t> h_in_compact;
  std::vector<uint32_t> h_in_varmajor(elems, 0u);
  std::vector<uint32_t> h_out_gpu_verify(elemsAlloc, 0);
  std::vector<uint32_t> h_out_gpu_compact;
  std::vector<uint32_t> h_out_cpu_varmajor(elems, 0);

  applyInitMode(h_seed_varmajor, nvars, nstates, initMode, initSeed);
  InitFileStats initStats;
  if (!initFile.empty()) {
    initStats = applyInitFile(h_seed_varmajor, nvars, nstates, "kernel_generated.vars.tsv", initFile);
  }
  const auto widths = loadVarWidths("kernel_generated.vars.tsv", nvars);
  std::vector<uint32_t> hybridReadVarIdxs;
  std::vector<uint32_t> hybridReadFromOutputVarIdxs;
  std::vector<uint32_t> hybridReadInputVarIdxs;
  std::vector<uint32_t> hybridWriteVarIdxs;
  std::vector<std::vector<uint32_t>> hybridGroupReadFromOutputVarIdxs(clusterCount);
  std::vector<std::vector<uint32_t>> hybridGroupAllWriteVarIdxs(clusterCount);
  std::vector<std::vector<uint32_t>> hybridGroupWriteVarIdxs(clusterCount);
  std::vector<uint8_t> hybridSelectedClusterMask(clusterCount, 0);
  uint32_t hybridClusterGroupAssignCount = 0;
  uint64_t hybridClusterGroupInputSignatureBits = 0;
  size_t hybridBoundaryInputBytes = 0;
  size_t hybridBoundaryOutputBytes = 0;
  size_t hybridStaticH2dBytes = 0;
  size_t hybridDynamicH2dBytes = 0;
  size_t hybridActualH2dBytes = 0;
  size_t hybridActualD2hBytes = 0;
  std::vector<uint8_t> hybridCpuNeededVarMask(nvars, 0);
  for (const uint32_t varIdx : outputVarIdxs) {
    if (varIdx < nvars) hybridCpuNeededVarMask[varIdx] = 1;
  }
  if (hybridMode == "single-partition") {
    for (uint32_t partitionIdx = hybridPartitionIndex + 1; partitionIdx < partitionCount; ++partitionIdx) {
      const auto laterReadVarIdxs = loadPartitionVarIdxs(partitionIdx,
                                                         sim_accel_eval_partition_read_count,
                                                         sim_accel_eval_partition_read_var_index);
      for (const uint32_t varIdx : laterReadVarIdxs) {
        if (varIdx < nvars) hybridCpuNeededVarMask[varIdx] = 1;
      }
    }
    hybridReadVarIdxs = loadPartitionVarIdxs(hybridPartitionIndex,
                                             sim_accel_eval_partition_read_count,
                                             sim_accel_eval_partition_read_var_index);
    hybridReadFromOutputVarIdxs
        = loadPartitionVarIdxs(hybridPartitionIndex,
                               sim_accel_eval_partition_read_from_output_count,
                               sim_accel_eval_partition_read_from_output_var_index);
    hybridReadInputVarIdxs
        = subtractOrderedVarIdxs(hybridReadVarIdxs, hybridReadFromOutputVarIdxs, nvars);
    const auto hybridAllWriteVarIdxs = loadPartitionVarIdxs(hybridPartitionIndex,
                                                            sim_accel_eval_partition_write_count,
                                                            sim_accel_eval_partition_write_var_index);
    hybridWriteVarIdxs = filterOrderedVarIdxsByMask(hybridAllWriteVarIdxs, hybridCpuNeededVarMask);
    hybridBoundaryInputBytes = logicalBytesPerBatch(hybridReadVarIdxs, widths, nstates);
    hybridBoundaryOutputBytes = logicalBytesPerBatch(hybridWriteVarIdxs, widths, nstates);
    hybridStaticH2dBytes = compactTransferBytes(hybridReadInputVarIdxs, nstates);
    hybridDynamicH2dBytes = compactTransferBytes(hybridReadFromOutputVarIdxs, nstates);
    hybridActualH2dBytes = hybridStaticH2dBytes + hybridDynamicH2dBytes;
    hybridActualD2hBytes = compactTransferBytes(hybridWriteVarIdxs, nstates);
  } else if (hybridMode == "single-cluster") {
    for (uint32_t clusterIdx : clusterTopoOrder) {
      if (clusterIdx == hybridClusterIndex) continue;
      const auto laterReadVarIdxs = loadPartitionVarIdxs(clusterIdx, sim_accel_eval_cluster_read_count,
                                                         sim_accel_eval_cluster_read_var_index);
      for (const uint32_t varIdx : laterReadVarIdxs) {
        if (varIdx < nvars) hybridCpuNeededVarMask[varIdx] = 1;
      }
    }
    hybridReadVarIdxs = loadPartitionVarIdxs(hybridClusterIndex, sim_accel_eval_cluster_read_count,
                                             sim_accel_eval_cluster_read_var_index);
    hybridReadFromOutputVarIdxs
        = loadPartitionVarIdxs(hybridClusterIndex,
                               sim_accel_eval_cluster_read_from_output_count,
                               sim_accel_eval_cluster_read_from_output_var_index);
    hybridReadInputVarIdxs
        = subtractOrderedVarIdxs(hybridReadVarIdxs, hybridReadFromOutputVarIdxs, nvars);
    const auto hybridAllWriteVarIdxs = loadPartitionVarIdxs(hybridClusterIndex,
                                                            sim_accel_eval_cluster_write_count,
                                                            sim_accel_eval_cluster_write_var_index);
    hybridWriteVarIdxs = filterOrderedVarIdxsByMask(hybridAllWriteVarIdxs, hybridCpuNeededVarMask);
    hybridBoundaryInputBytes = logicalBytesPerBatch(hybridReadVarIdxs, widths, nstates);
    hybridBoundaryOutputBytes = logicalBytesPerBatch(hybridWriteVarIdxs, widths, nstates);
    hybridStaticH2dBytes = compactTransferBytes(hybridReadInputVarIdxs, nstates);
    hybridDynamicH2dBytes = compactTransferBytes(hybridReadFromOutputVarIdxs, nstates);
    hybridActualH2dBytes = hybridStaticH2dBytes + hybridDynamicH2dBytes;
    hybridActualD2hBytes = compactTransferBytes(hybridWriteVarIdxs, nstates);
  } else if (hybridMode == "cluster-group") {
    std::vector<std::vector<uint32_t>> groupReadVarIdxLists;
    std::vector<std::vector<uint32_t>> groupReadFromOutputVarIdxLists;
    std::vector<std::vector<uint32_t>> groupWritebackVarIdxLists;
    std::vector<uint8_t> gpuProducedVarMask(nvars, 0);
    for (uint32_t clusterIdx : hybridClusterIndices) {
      hybridSelectedClusterMask[clusterIdx] = 1;
    }
    for (uint32_t clusterIdx : clusterTopoOrder) {
      if (clusterIdx < hybridSelectedClusterMask.size() && hybridSelectedClusterMask[clusterIdx]) continue;
      const auto laterReadVarIdxs = loadPartitionVarIdxs(clusterIdx, sim_accel_eval_cluster_read_count,
                                                         sim_accel_eval_cluster_read_var_index);
      for (const uint32_t varIdx : laterReadVarIdxs) {
        if (varIdx < nvars) hybridCpuNeededVarMask[varIdx] = 1;
      }
    }
    for (uint32_t clusterIdx : hybridClusterIndices) {
      hybridClusterGroupAssignCount += sim_accel_eval_cluster_assign_count(clusterIdx);
      hybridClusterGroupInputSignatureBits
          += sim_accel_eval_cluster_input_signature_bits(clusterIdx);
      auto readVarIdxs = loadPartitionVarIdxs(clusterIdx, sim_accel_eval_cluster_read_count,
                                             sim_accel_eval_cluster_read_var_index);
      auto readFromOutputVarIdxs = loadPartitionVarIdxs(
          clusterIdx, sim_accel_eval_cluster_read_from_output_count,
          sim_accel_eval_cluster_read_from_output_var_index);
      auto writeVarIdxs = loadPartitionVarIdxs(clusterIdx, sim_accel_eval_cluster_write_count,
                                              sim_accel_eval_cluster_write_var_index);
      hybridGroupReadFromOutputVarIdxs[clusterIdx] = readFromOutputVarIdxs;
      hybridGroupAllWriteVarIdxs[clusterIdx] = writeVarIdxs;
      hybridGroupWriteVarIdxs[clusterIdx]
          = filterOrderedVarIdxsByMask(writeVarIdxs, hybridCpuNeededVarMask);
      groupReadVarIdxLists.push_back(readVarIdxs);
      groupReadFromOutputVarIdxLists.push_back(readFromOutputVarIdxs);
      groupWritebackVarIdxLists.push_back(hybridGroupWriteVarIdxs[clusterIdx]);
    }
    hybridReadVarIdxs = unionOrderedVarIdxLists(groupReadVarIdxLists, nvars);
    hybridReadFromOutputVarIdxs = unionOrderedVarIdxLists(groupReadFromOutputVarIdxLists, nvars);
    hybridReadInputVarIdxs
        = subtractOrderedVarIdxs(hybridReadVarIdxs, hybridReadFromOutputVarIdxs, nvars);
    hybridWriteVarIdxs = unionOrderedVarIdxLists(groupWritebackVarIdxLists, nvars);
    hybridBoundaryInputBytes = logicalBytesPerBatch(hybridReadVarIdxs, widths, nstates);
    hybridBoundaryOutputBytes = logicalBytesPerBatch(hybridWriteVarIdxs, widths, nstates);
    hybridStaticH2dBytes = compactTransferBytes(hybridReadInputVarIdxs, nstates);
    for (uint32_t clusterIdx : clusterTopoOrder) {
      if (!hybridSelectedClusterMask[clusterIdx]) continue;
      const auto& readFromOutputVarIdxs = hybridGroupReadFromOutputVarIdxs[clusterIdx];
      std::vector<uint32_t> externalReadFromOutputVarIdxs;
      externalReadFromOutputVarIdxs.reserve(readFromOutputVarIdxs.size());
      for (uint32_t varIdx : readFromOutputVarIdxs) {
        if (varIdx < nvars && !gpuProducedVarMask[varIdx]) {
          externalReadFromOutputVarIdxs.push_back(varIdx);
        }
      }
      hybridDynamicH2dBytes += compactTransferBytes(externalReadFromOutputVarIdxs, nstates);
      hybridActualD2hBytes += compactTransferBytes(hybridGroupWriteVarIdxs[clusterIdx], nstates);
      for (uint32_t varIdx : hybridGroupAllWriteVarIdxs[clusterIdx]) {
        if (varIdx < nvars) gpuProducedVarMask[varIdx] = 1;
      }
    }
    hybridActualH2dBytes = hybridStaticH2dBytes + hybridDynamicH2dBytes;
  }
  for (uint32_t idx = 0; idx < nvars; ++idx) {
    const size_t base = static_cast<size_t>(idx) * nstates;
    for (uint32_t tid = 0; tid < nstates; ++tid) {
      h_seed_varmajor[base + tid] = maskToWidth(h_seed_varmajor[base + tid], widths[idx]);
    }
  }
  h_in_compact = gatherSlotsVarMajor(h_seed_varmajor, inputVarIdxs, nstates);
  for (size_t slot = 0; slot < inputVarIdxs.size(); ++slot) {
    const size_t srcBase = slot * static_cast<size_t>(nstates);
    const size_t dstBase = static_cast<size_t>(inputVarIdxs[slot]) * nstates;
    std::copy_n(h_in_compact.begin() + srcBase, nstates, h_in_varmajor.begin() + dstBase);
  }

  uint32_t* d_inputVarIdxs = nullptr;
  uint32_t* d_outputVarIdxs = nullptr;
  uint32_t* d_in_compact = nullptr;
  uint32_t* d_out_compact = nullptr;
  uint32_t* d_hybridInputVarIdxs = nullptr;
  uint32_t* d_hybridInputCompact = nullptr;
  uint32_t* d_hybridReadOutputVarIdxs = nullptr;
  uint32_t* d_hybridReadOutputCompact = nullptr;
  uint32_t* d_hybridWriteVarIdxs = nullptr;
  uint32_t* d_hybridWriteCompact = nullptr;
  uint32_t* d_in = nullptr;
  uint32_t* d_out = nullptr;
  if (!inputVarIdxs.empty()) {
    checkCuda(cudaMalloc(&d_inputVarIdxs, inputVarIdxs.size() * sizeof(uint32_t)),
              "cudaMalloc d_inputVarIdxs");
    checkCuda(cudaMemcpy(d_inputVarIdxs, inputVarIdxs.data(), inputVarIdxs.size() * sizeof(uint32_t),
                         cudaMemcpyHostToDevice),
              "H2D input var idxs");
    checkCuda(cudaMalloc(&d_in_compact, compactInputBytes), "cudaMalloc d_in_compact");
    checkCuda(cudaMemcpy(d_in_compact, h_in_compact.data(), compactInputBytes, cudaMemcpyHostToDevice),
              "H2D compact in");
  }
  if (!outputVarIdxs.empty()) {
    checkCuda(cudaMalloc(&d_outputVarIdxs, outputVarIdxs.size() * sizeof(uint32_t)),
              "cudaMalloc d_outputVarIdxs");
    checkCuda(cudaMemcpy(d_outputVarIdxs, outputVarIdxs.data(),
                         outputVarIdxs.size() * sizeof(uint32_t), cudaMemcpyHostToDevice),
              "H2D output var idxs");
    checkCuda(cudaMalloc(&d_out_compact, compactOutputBytes), "cudaMalloc d_out_compact");
    h_out_gpu_compact.assign(compactOutputElems, 0u);
  }
  checkCuda(cudaMalloc(&d_in, bytes), "cudaMalloc d_in");
  checkCuda(cudaMalloc(&d_out, bytes), "cudaMalloc d_out");
  checkCuda(cudaMemset(d_in, 0, bytes), "memset d_in");
  checkCuda(cudaMemset(d_out, 0, bytes), "memset d_out");
  if (!inputVarIdxs.empty()) {
    const int scatterBlock = static_cast<int>(blockSize);
    const int scatterGrid = static_cast<int>((nstates + scatterBlock - 1) / scatterBlock);
    sim_accel_scatter_inputs_u32<<<scatterGrid, scatterBlock>>>(
        d_in_compact, d_inputVarIdxs, static_cast<uint32_t>(inputVarIdxs.size()), d_in, nvars,
        nstates, stateChunk);
    checkCuda(cudaGetLastError(), "scatter launch");
    checkCuda(cudaDeviceSynchronize(), "scatter sync");
  }

  std::vector<uint32_t> h_hybridInputCompact;
  std::vector<uint32_t> h_hybridReadOutputCompact;
  std::vector<uint32_t> h_hybridWriteCompact;
  double hybridSetupH2dMs = 0.0;
  if (hybridMode != "off") {
    if (!hybridReadInputVarIdxs.empty()) {
      h_hybridInputCompact = gatherSlotsVarMajor(h_in_varmajor, hybridReadInputVarIdxs, nstates);
      checkCuda(cudaMalloc(&d_hybridInputVarIdxs,
                           hybridReadInputVarIdxs.size() * sizeof(uint32_t)),
                "cudaMalloc d_hybridInputVarIdxs");
      checkCuda(cudaMemcpy(d_hybridInputVarIdxs, hybridReadInputVarIdxs.data(),
                           hybridReadInputVarIdxs.size() * sizeof(uint32_t), cudaMemcpyHostToDevice),
                "H2D hybrid input var idxs");
      checkCuda(cudaMalloc(&d_hybridInputCompact,
                           static_cast<size_t>(hybridReadInputVarIdxs.size()) * nstates * sizeof(uint32_t)),
                "cudaMalloc d_hybridInputCompact");
      auto hybridStaticH2dT0 = std::chrono::high_resolution_clock::now();
      checkCuda(cudaMemcpy(d_hybridInputCompact, h_hybridInputCompact.data(),
                           static_cast<size_t>(hybridReadInputVarIdxs.size()) * nstates * sizeof(uint32_t),
                           cudaMemcpyHostToDevice),
                "H2D hybrid input compact");
      const int scatterBlock = static_cast<int>(blockSize);
      const int scatterGrid = static_cast<int>((nstates + scatterBlock - 1) / scatterBlock);
      sim_accel_scatter_inputs_u32<<<scatterGrid, scatterBlock>>>(
          d_hybridInputCompact, d_hybridInputVarIdxs,
          static_cast<uint32_t>(hybridReadInputVarIdxs.size()), d_in, nvars, nstates, 0);
      checkCuda(cudaGetLastError(), "hybrid input scatter launch");
      checkCuda(cudaDeviceSynchronize(), "hybrid input scatter sync");
      auto hybridStaticH2dT1 = std::chrono::high_resolution_clock::now();
      hybridSetupH2dMs = std::chrono::duration<double, std::milli>(hybridStaticH2dT1 - hybridStaticH2dT0).count();
    }
    if (!hybridReadFromOutputVarIdxs.empty()) {
      checkCuda(cudaMalloc(&d_hybridReadOutputVarIdxs,
                           hybridReadFromOutputVarIdxs.size() * sizeof(uint32_t)),
                "cudaMalloc d_hybridReadOutputVarIdxs");
      checkCuda(cudaMemcpy(d_hybridReadOutputVarIdxs, hybridReadFromOutputVarIdxs.data(),
                           hybridReadFromOutputVarIdxs.size() * sizeof(uint32_t),
                           cudaMemcpyHostToDevice),
                "H2D hybrid read-output var idxs");
      checkCuda(cudaMalloc(&d_hybridReadOutputCompact,
                           static_cast<size_t>(hybridReadFromOutputVarIdxs.size()) * nstates
                               * sizeof(uint32_t)),
                "cudaMalloc d_hybridReadOutputCompact");
      h_hybridReadOutputCompact.assign(
          static_cast<size_t>(hybridReadFromOutputVarIdxs.size()) * nstates, 0u);
    }
    if (!hybridWriteVarIdxs.empty()) {
      checkCuda(cudaMalloc(&d_hybridWriteVarIdxs, hybridWriteVarIdxs.size() * sizeof(uint32_t)),
                "cudaMalloc d_hybridWriteVarIdxs");
      checkCuda(cudaMemcpy(d_hybridWriteVarIdxs, hybridWriteVarIdxs.data(),
                           hybridWriteVarIdxs.size() * sizeof(uint32_t), cudaMemcpyHostToDevice),
                "H2D hybrid write var idxs");
      checkCuda(cudaMalloc(&d_hybridWriteCompact,
                           static_cast<size_t>(hybridWriteVarIdxs.size()) * nstates * sizeof(uint32_t)),
                "cudaMalloc d_hybridWriteCompact");
      h_hybridWriteCompact.assign(static_cast<size_t>(hybridWriteVarIdxs.size()) * nstates, 0u);
    }
  }

  #ifndef SIM_ACCEL_SKIP_CPU_REFERENCE_BUILD
  auto runCpuPartitionPass = [&](std::vector<uint32_t>& stateOut) {
    stateOut = h_in_varmajor;
    for (uint32_t partitionIdx = 0; partitionIdx < partitionCount; ++partitionIdx) {
      sim_accel_eval_assignw_cpu_partition(partitionIdx, h_in_varmajor.data(), stateOut.data(),
                                           nstates);
    }
  };

  auto runCpuClusterPass = [&](std::vector<uint32_t>& stateOut) {
    stateOut = h_in_varmajor;
    for (uint32_t clusterIdx : clusterTopoOrder) {
      sim_accel_eval_assignw_cpu_cluster_dispatch(clusterIdx, h_in_varmajor.data(), stateOut.data(),
                                                  nstates);
    }
  };

  auto runHybridPartitionPass = [&](std::vector<uint32_t>& stateOut, HybridTimingStats* statsp) {
    stateOut = h_in_varmajor;
    for (uint32_t partitionIdx = 0; partitionIdx < partitionCount; ++partitionIdx) {
      if (partitionIdx == hybridPartitionIndex) {
        if (!hybridReadFromOutputVarIdxs.empty()) {
          auto h2dT0 = std::chrono::high_resolution_clock::now();
          gatherSlotsVarMajorInto(stateOut, hybridReadFromOutputVarIdxs, nstates,
                                  &h_hybridReadOutputCompact);
          checkCuda(cudaMemcpy(d_hybridReadOutputCompact, h_hybridReadOutputCompact.data(),
                               h_hybridReadOutputCompact.size() * sizeof(uint32_t),
                               cudaMemcpyHostToDevice),
                    "H2D hybrid partition read-output compact");
          const int scatterBlock = static_cast<int>(blockSize);
          const int scatterGrid = static_cast<int>((nstates + scatterBlock - 1) / scatterBlock);
          sim_accel_scatter_inputs_u32<<<scatterGrid, scatterBlock>>>(
              d_hybridReadOutputCompact, d_hybridReadOutputVarIdxs,
              static_cast<uint32_t>(hybridReadFromOutputVarIdxs.size()), d_out, nvars, nstates, 0);
          checkCuda(cudaGetLastError(), "hybrid partition read-output scatter launch");
          checkCuda(cudaDeviceSynchronize(), "hybrid partition read-output scatter sync");
          auto h2dT1 = std::chrono::high_resolution_clock::now();
          if (statsp) {
            statsp->dynamic_h2d_ms += std::chrono::duration<double, std::milli>(h2dT1 - h2dT0).count();
          }
        }
        auto kernelT0 = std::chrono::high_resolution_clock::now();
        checkCuda(sim_accel_eval_assignw_launch_partition(partitionIdx, d_in, d_out, nstates,
                                                          blockSize),
                  "launch_partition hybrid");
        checkCuda(cudaDeviceSynchronize(), "hybrid partition sync");
        auto kernelT1 = std::chrono::high_resolution_clock::now();
        if (statsp) {
          statsp->kernel_ms += std::chrono::duration<double, std::milli>(kernelT1 - kernelT0).count();
        }
        if (!hybridWriteVarIdxs.empty()) {
          auto d2hT0 = std::chrono::high_resolution_clock::now();
          const int gatherBlock = static_cast<int>(blockSize);
          const int gatherGrid = static_cast<int>((nstates + gatherBlock - 1) / gatherBlock);
          sim_accel_gather_outputs_u32<<<gatherGrid, gatherBlock>>>(
              d_out, d_hybridWriteVarIdxs, static_cast<uint32_t>(hybridWriteVarIdxs.size()),
              d_hybridWriteCompact, nvars, nstates, 0);
          checkCuda(cudaGetLastError(), "hybrid partition write gather launch");
          checkCuda(cudaDeviceSynchronize(), "hybrid partition write gather sync");
          checkCuda(cudaMemcpy(h_hybridWriteCompact.data(), d_hybridWriteCompact,
                               h_hybridWriteCompact.size() * sizeof(uint32_t),
                               cudaMemcpyDeviceToHost),
                    "D2H hybrid partition write compact");
          scatterSlotsVarMajor(stateOut, h_hybridWriteCompact, hybridWriteVarIdxs, nstates);
          auto d2hT1 = std::chrono::high_resolution_clock::now();
          if (statsp) {
            statsp->d2h_ms += std::chrono::duration<double, std::milli>(d2hT1 - d2hT0).count();
          }
        }
      } else {
        auto cpuT0 = std::chrono::high_resolution_clock::now();
        sim_accel_eval_assignw_cpu_partition(partitionIdx, h_in_varmajor.data(), stateOut.data(),
                                             nstates);
        auto cpuT1 = std::chrono::high_resolution_clock::now();
        if (statsp) {
          statsp->cpu_dispatch_ms += std::chrono::duration<double, std::milli>(cpuT1 - cpuT0).count();
        }
      }
    }
  };

  auto runHybridClusterPass = [&](std::vector<uint32_t>& stateOut, HybridTimingStats* statsp) {
    stateOut = h_in_varmajor;
    for (uint32_t clusterIdx : clusterTopoOrder) {
      if (clusterIdx == hybridClusterIndex) {
        if (!hybridReadFromOutputVarIdxs.empty()) {
          auto h2dT0 = std::chrono::high_resolution_clock::now();
          gatherSlotsVarMajorInto(stateOut, hybridReadFromOutputVarIdxs, nstates,
                                  &h_hybridReadOutputCompact);
          checkCuda(cudaMemcpy(d_hybridReadOutputCompact, h_hybridReadOutputCompact.data(),
                               h_hybridReadOutputCompact.size() * sizeof(uint32_t),
                               cudaMemcpyHostToDevice),
                    "H2D hybrid cluster read-output compact");
          const int scatterBlock = static_cast<int>(blockSize);
          const int scatterGrid = static_cast<int>((nstates + scatterBlock - 1) / scatterBlock);
          sim_accel_scatter_inputs_u32<<<scatterGrid, scatterBlock>>>(
              d_hybridReadOutputCompact, d_hybridReadOutputVarIdxs,
              static_cast<uint32_t>(hybridReadFromOutputVarIdxs.size()), d_out, nvars, nstates, 0);
          checkCuda(cudaGetLastError(), "hybrid cluster read-output scatter launch");
          checkCuda(cudaDeviceSynchronize(), "hybrid cluster read-output scatter sync");
          auto h2dT1 = std::chrono::high_resolution_clock::now();
          if (statsp) {
            statsp->dynamic_h2d_ms += std::chrono::duration<double, std::milli>(h2dT1 - h2dT0).count();
          }
        }
        auto kernelT0 = std::chrono::high_resolution_clock::now();
        checkCuda(sim_accel_eval_assignw_launch_cluster(clusterIdx, d_in, d_out, nstates, blockSize),
                  "launch_cluster hybrid");
        checkCuda(cudaDeviceSynchronize(), "hybrid cluster sync");
        auto kernelT1 = std::chrono::high_resolution_clock::now();
        if (statsp) {
          statsp->kernel_ms += std::chrono::duration<double, std::milli>(kernelT1 - kernelT0).count();
        }
        if (!hybridWriteVarIdxs.empty()) {
          auto d2hT0 = std::chrono::high_resolution_clock::now();
          const int gatherBlock = static_cast<int>(blockSize);
          const int gatherGrid = static_cast<int>((nstates + gatherBlock - 1) / gatherBlock);
          sim_accel_gather_outputs_u32<<<gatherGrid, gatherBlock>>>(
              d_out, d_hybridWriteVarIdxs, static_cast<uint32_t>(hybridWriteVarIdxs.size()),
              d_hybridWriteCompact, nvars, nstates, 0);
          checkCuda(cudaGetLastError(), "hybrid cluster write gather launch");
          checkCuda(cudaDeviceSynchronize(), "hybrid cluster write gather sync");
          checkCuda(cudaMemcpy(h_hybridWriteCompact.data(), d_hybridWriteCompact,
                               h_hybridWriteCompact.size() * sizeof(uint32_t),
                               cudaMemcpyDeviceToHost),
                    "D2H hybrid cluster write compact");
          scatterSlotsVarMajor(stateOut, h_hybridWriteCompact, hybridWriteVarIdxs, nstates);
          auto d2hT1 = std::chrono::high_resolution_clock::now();
          if (statsp) {
            statsp->d2h_ms += std::chrono::duration<double, std::milli>(d2hT1 - d2hT0).count();
          }
        }
      } else {
        auto cpuT0 = std::chrono::high_resolution_clock::now();
        sim_accel_eval_assignw_cpu_cluster_dispatch(clusterIdx, h_in_varmajor.data(),
                                                    stateOut.data(), nstates);
        auto cpuT1 = std::chrono::high_resolution_clock::now();
        if (statsp) {
          statsp->cpu_dispatch_ms += std::chrono::duration<double, std::milli>(cpuT1 - cpuT0).count();
        }
      }
    }
  };

  auto runHybridClusterGroupPass = [&](std::vector<uint32_t>& stateOut, HybridTimingStats* statsp) {
    stateOut = h_in_varmajor;
    std::vector<uint8_t> gpuProducedVarMask(nvars, 0);
    for (uint32_t clusterIdx : clusterTopoOrder) {
      if (clusterIdx < hybridSelectedClusterMask.size() && hybridSelectedClusterMask[clusterIdx]) {
        const auto& clusterReadFromOutputVarIdxs = hybridGroupReadFromOutputVarIdxs[clusterIdx];
        std::vector<uint32_t> externalReadFromOutputVarIdxs;
        externalReadFromOutputVarIdxs.reserve(clusterReadFromOutputVarIdxs.size());
        for (uint32_t varIdx : clusterReadFromOutputVarIdxs) {
          if (varIdx < nvars && !gpuProducedVarMask[varIdx]) {
            externalReadFromOutputVarIdxs.push_back(varIdx);
          }
        }
        if (!externalReadFromOutputVarIdxs.empty()) {
          auto h2dT0 = std::chrono::high_resolution_clock::now();
          gatherSlotsVarMajorInto(stateOut, externalReadFromOutputVarIdxs, nstates,
                                  &h_hybridReadOutputCompact);
          checkCuda(cudaMemcpy(d_hybridReadOutputVarIdxs, externalReadFromOutputVarIdxs.data(),
                               externalReadFromOutputVarIdxs.size() * sizeof(uint32_t),
                               cudaMemcpyHostToDevice),
                    "H2D hybrid cluster-group read-output var idxs");
          checkCuda(cudaMemcpy(d_hybridReadOutputCompact, h_hybridReadOutputCompact.data(),
                               h_hybridReadOutputCompact.size() * sizeof(uint32_t),
                               cudaMemcpyHostToDevice),
                    "H2D hybrid cluster-group read-output compact");
          const int scatterBlock = static_cast<int>(blockSize);
          const int scatterGrid = static_cast<int>((nstates + scatterBlock - 1) / scatterBlock);
          sim_accel_scatter_inputs_u32<<<scatterGrid, scatterBlock>>>(
              d_hybridReadOutputCompact, d_hybridReadOutputVarIdxs,
              static_cast<uint32_t>(externalReadFromOutputVarIdxs.size()), d_out, nvars, nstates,
              0);
          checkCuda(cudaGetLastError(), "hybrid cluster-group read-output scatter launch");
          checkCuda(cudaDeviceSynchronize(), "hybrid cluster-group read-output scatter sync");
          auto h2dT1 = std::chrono::high_resolution_clock::now();
          if (statsp) {
            statsp->dynamic_h2d_ms += std::chrono::duration<double, std::milli>(h2dT1 - h2dT0).count();
          }
        }
        auto kernelT0 = std::chrono::high_resolution_clock::now();
        checkCuda(sim_accel_eval_assignw_launch_cluster(clusterIdx, d_in, d_out, nstates, blockSize),
                  "launch_cluster hybrid group");
        checkCuda(cudaDeviceSynchronize(), "hybrid cluster-group sync");
        auto kernelT1 = std::chrono::high_resolution_clock::now();
        if (statsp) {
          statsp->kernel_ms += std::chrono::duration<double, std::milli>(kernelT1 - kernelT0).count();
        }
        const auto& clusterWriteVarIdxs = hybridGroupWriteVarIdxs[clusterIdx];
        if (!clusterWriteVarIdxs.empty()) {
          h_hybridWriteCompact.resize(static_cast<size_t>(clusterWriteVarIdxs.size()) * nstates);
          auto d2hT0 = std::chrono::high_resolution_clock::now();
          checkCuda(cudaMemcpy(d_hybridWriteVarIdxs, clusterWriteVarIdxs.data(),
                               clusterWriteVarIdxs.size() * sizeof(uint32_t),
                               cudaMemcpyHostToDevice),
                    "H2D hybrid cluster-group write var idxs");
          const int gatherBlock = static_cast<int>(blockSize);
          const int gatherGrid = static_cast<int>((nstates + gatherBlock - 1) / gatherBlock);
          sim_accel_gather_outputs_u32<<<gatherGrid, gatherBlock>>>(
              d_out, d_hybridWriteVarIdxs, static_cast<uint32_t>(clusterWriteVarIdxs.size()),
              d_hybridWriteCompact, nvars, nstates, 0);
          checkCuda(cudaGetLastError(), "hybrid cluster-group write gather launch");
          checkCuda(cudaDeviceSynchronize(), "hybrid cluster-group write gather sync");
          checkCuda(cudaMemcpy(h_hybridWriteCompact.data(), d_hybridWriteCompact,
                               h_hybridWriteCompact.size() * sizeof(uint32_t),
                               cudaMemcpyDeviceToHost),
                    "D2H hybrid cluster-group write compact");
          scatterSlotsVarMajor(stateOut, h_hybridWriteCompact, clusterWriteVarIdxs, nstates);
          auto d2hT1 = std::chrono::high_resolution_clock::now();
          if (statsp) {
            statsp->d2h_ms += std::chrono::duration<double, std::milli>(d2hT1 - d2hT0).count();
          }
          for (uint32_t varIdx : clusterWriteVarIdxs) {
            if (varIdx < nvars) gpuProducedVarMask[varIdx] = 1;
          }
        }
      } else {
        auto cpuT0 = std::chrono::high_resolution_clock::now();
        sim_accel_eval_assignw_cpu_cluster_dispatch(clusterIdx, h_in_varmajor.data(),
                                                    stateOut.data(), nstates);
        auto cpuT1 = std::chrono::high_resolution_clock::now();
        if (statsp) {
          statsp->cpu_dispatch_ms += std::chrono::duration<double, std::milli>(cpuT1 - cpuT0).count();
        }
      }
    }
  };
  #else
  auto failSkippedCpuReferenceHybrid = [&]() {
    std::cerr << "Internal error: hybrid execution requires CPU reference build\n";
    std::exit(2);
  };

  auto runCpuPartitionPass = [&](std::vector<uint32_t>&) {
    failSkippedCpuReferenceHybrid();
  };

  auto runCpuClusterPass = [&](std::vector<uint32_t>&) {
    failSkippedCpuReferenceHybrid();
  };

  auto runHybridPartitionPass = [&](std::vector<uint32_t>&, HybridTimingStats*) {
    failSkippedCpuReferenceHybrid();
  };

  auto runHybridClusterPass = [&](std::vector<uint32_t>&, HybridTimingStats*) {
    failSkippedCpuReferenceHybrid();
  };

  auto runHybridClusterGroupPass = [&](std::vector<uint32_t>&, HybridTimingStats*) {
    failSkippedCpuReferenceHybrid();
  };
  #endif

  std::vector<uint32_t> h_out_gpu_varmajor;
  std::vector<uint32_t> h_out_hybrid_varmajor(elems, 0u);
  float gpu_ms = 0.0f;
  double cpu_ms = 0.0;
  double hybrid_ms = 0.0;
  double hybrid_cpu_ms = 0.0;
  HybridTimingStats hybridTimingTotal;

  if (hybridMode == "off") {
    for (int i = 0; i < 10; ++i) {
      if (!useChunkLayout) {
        checkCuda(sim_accel_eval_assignw_launch_all(d_in, d_out, nstates, blockSize),
                  "launch_all warmup");
      } else {
        const size_t chunkElems = static_cast<size_t>(nvars) * stateChunk;
        for (uint32_t chunkId = 0; chunkId < nchunks; ++chunkId) {
          const size_t off = static_cast<size_t>(chunkId) * chunkElems;
          checkCuda(sim_accel_eval_assignw_launch_all(d_in + off, d_out + off, stateChunk, blockSize),
                    "launch_all warmup chunk");
        }
      }
    }
    checkCuda(cudaDeviceSynchronize(), "warmup sync");

    cudaEvent_t evStart, evStop;
    checkCuda(cudaEventCreate(&evStart), "event create start");
    checkCuda(cudaEventCreate(&evStop), "event create stop");
    checkCuda(cudaEventRecord(evStart), "event record start");
    for (int i = 0; i < gpu_reps; ++i) {
      if (!useChunkLayout) {
        checkCuda(sim_accel_eval_assignw_launch_all(d_in, d_out, nstates, blockSize),
                  "launch_all timed");
      } else {
        const size_t chunkElems = static_cast<size_t>(nvars) * stateChunk;
        for (uint32_t chunkId = 0; chunkId < nchunks; ++chunkId) {
          const size_t off = static_cast<size_t>(chunkId) * chunkElems;
          checkCuda(sim_accel_eval_assignw_launch_all(d_in + off, d_out + off, stateChunk, blockSize),
                    "launch_all timed chunk");
        }
      }
    }
    checkCuda(cudaEventRecord(evStop), "event record stop");
    checkCuda(cudaEventSynchronize(evStop), "event sync stop");
    checkCuda(cudaEventElapsedTime(&gpu_ms, evStart, evStop), "elapsed");
    if (!outputVarIdxs.empty()) {
      const int gatherBlock = static_cast<int>(blockSize);
      const int gatherGrid = static_cast<int>((nstates + gatherBlock - 1) / gatherBlock);
      sim_accel_gather_outputs_u32<<<gatherGrid, gatherBlock>>>(
          d_out, d_outputVarIdxs, static_cast<uint32_t>(outputVarIdxs.size()), d_out_compact, nvars,
          nstates, stateChunk);
      checkCuda(cudaGetLastError(), "gather launch");
      checkCuda(cudaDeviceSynchronize(), "gather sync");
      checkCuda(cudaMemcpy(h_out_gpu_compact.data(), d_out_compact, compactOutputBytes,
                           cudaMemcpyDeviceToHost),
                "D2H compact out");
    }
    checkCuda(cudaMemcpy(h_out_gpu_verify.data(), d_out, bytes, cudaMemcpyDeviceToHost),
              "D2H verify full out");
    h_out_gpu_varmajor = useChunkLayout ? unchunkToVarMajor(h_out_gpu_verify, nvars, nstates, stateChunk)
                                        : std::vector<uint32_t>(h_out_gpu_verify.begin(),
                                                                h_out_gpu_verify.begin() + elems);
    cudaEventDestroy(evStart);
    cudaEventDestroy(evStop);
  } else {
    std::vector<uint32_t> hybridWarmup(elems, 0u);
    for (int i = 0; i < 3; ++i) {
      if (hybridMode == "single-partition") {
        runHybridPartitionPass(hybridWarmup, nullptr);
      } else if (hybridMode == "single-cluster") {
        runHybridClusterPass(hybridWarmup, nullptr);
      } else {
        runHybridClusterGroupPass(hybridWarmup, nullptr);
      }
    }
    auto hybrid_t0 = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < gpu_reps; ++i) {
      if (hybridMode == "single-partition") {
        runHybridPartitionPass(h_out_hybrid_varmajor, &hybridTimingTotal);
      } else if (hybridMode == "single-cluster") {
        runHybridClusterPass(h_out_hybrid_varmajor, &hybridTimingTotal);
      } else {
        runHybridClusterGroupPass(h_out_hybrid_varmajor, &hybridTimingTotal);
      }
    }
    auto hybrid_t1 = std::chrono::high_resolution_clock::now();
    hybrid_ms = std::chrono::duration<double, std::milli>(hybrid_t1 - hybrid_t0).count();

    std::vector<uint32_t> h_out_cpu_partition_varmajor(elems, 0u);
    auto hybrid_cpu_t0 = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < cpu_reps; ++i) {
      if (hybridMode == "single-partition") {
        runCpuPartitionPass(h_out_cpu_partition_varmajor);
      } else {
        runCpuClusterPass(h_out_cpu_partition_varmajor);
      }
    }
    auto hybrid_cpu_t1 = std::chrono::high_resolution_clock::now();
    hybrid_cpu_ms = std::chrono::duration<double, std::milli>(hybrid_cpu_t1 - hybrid_cpu_t0).count();
  }

#ifndef SIM_ACCEL_SKIP_CPU_REFERENCE_BUILD
  {
    auto cpu_t0 = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < cpu_reps; ++i) {
      sim_accel_eval_assignw_cpu(h_in_varmajor.data(), h_out_cpu_varmajor.data(), nstates);
    }
    auto cpu_t1 = std::chrono::high_resolution_clock::now();
    cpu_ms = std::chrono::duration<double, std::milli>(cpu_t1 - cpu_t0).count();
  }
#endif
  size_t mismatch = 0;
  size_t compactMismatch = 0;
  size_t hybridMismatch = 0;
#ifndef SIM_ACCEL_SKIP_CPU_REFERENCE_BUILD
  sim_accel_eval_assignw_cpu(h_in_varmajor.data(), h_out_cpu_varmajor.data(), nstates);
  const std::vector<uint32_t> h_out_cpu_compact
      = gatherSlotsVarMajor(h_out_cpu_varmajor, outputVarIdxs, nstates);
  if (hybridMode == "off") {
    for (size_t i = 0; i < elems; ++i) {
      if (h_out_cpu_varmajor[i] != h_out_gpu_varmajor[i]) ++mismatch;
    }
    for (size_t i = 0; i < h_out_cpu_compact.size(); ++i) {
      if (h_out_cpu_compact[i] != h_out_gpu_compact[i]) ++compactMismatch;
    }
  } else {
    for (size_t i = 0; i < elems; ++i) {
      if (h_out_cpu_varmajor[i] != h_out_hybrid_varmajor[i]) ++hybridMismatch;
    }
  }
#endif

  const double gpu_ms_per_rep = (hybridMode == "off") ? (gpu_ms / gpu_reps) : 0.0;
  const double cpu_ms_per_rep = cpu_ms / cpu_reps;
  const double hybrid_ms_per_rep = (hybridMode == "off") ? 0.0 : (hybrid_ms / gpu_reps);
  const double hybrid_cpu_ms_per_rep = (hybridMode == "off") ? 0.0 : (hybrid_cpu_ms / cpu_reps);
  const double hybrid_setup_h2d_ms = (hybridMode == "off") ? 0.0 : hybridSetupH2dMs;
  const double hybrid_dynamic_h2d_ms_per_rep
      = (hybridMode == "off") ? 0.0 : (hybridTimingTotal.dynamic_h2d_ms / gpu_reps);
  const double hybrid_kernel_ms_per_rep
      = (hybridMode == "off") ? 0.0 : (hybridTimingTotal.kernel_ms / gpu_reps);
  const double hybrid_d2h_ms_per_rep
      = (hybridMode == "off") ? 0.0 : (hybridTimingTotal.d2h_ms / gpu_reps);
  const double hybrid_transfer_ms_per_rep = hybrid_dynamic_h2d_ms_per_rep + hybrid_d2h_ms_per_rep;
  const double hybrid_cpu_dispatch_ms_per_rep
      = (hybridMode == "off") ? 0.0 : (hybridTimingTotal.cpu_dispatch_ms / gpu_reps);
  const double speedup = (hybridMode == "off" && gpu_ms_per_rep > 0.0)
                             ? (cpu_ms_per_rep / gpu_ms_per_rep)
                             : 0.0;
  const double eps = 0.05;

  std::cout << std::fixed << std::setprecision(6);
  std::cout << "nvars=" << nvars << " nstates=" << nstates << " elems=" << elems << "\n";
  std::cout << "state_chunk=" << (useChunkLayout ? stateChunk : 0) << "\n";
  std::cout << "block_size=" << blockSize << "\n";
  std::cout << "kernel_partitions=" << partitionCount << "\n";
  std::cout << "kernel_clusters=" << clusterCount << "\n";
  std::cout << "state_chunks=" << nchunks << "\n";
  std::cout << "padded_states=" << paddedStates << "\n";
  std::cout << "cpu_reference_build=" << (kSimAccelSkipCpuReferenceBuild ? 0 : 1) << "\n";
  std::cout << "cpu_reference_checked=" << (kSimAccelSkipCpuReferenceBuild ? 0 : 1) << "\n";
  std::cout << "init_mode=" << initMode << "\n";
  std::cout << "init_seed=" << initSeed << "\n";
  if (!initFile.empty()) {
    std::cout << "init_file=" << initFile << "\n";
    std::cout << "init_file_rules_applied=" << initStats.rules_applied << "\n";
    std::cout << "init_file_values_applied=" << initStats.values_applied << "\n";
    std::cout << "init_file_lines_ignored=" << initStats.lines_ignored << "\n";
  }
  std::cout << "hybrid_mode=" << hybridMode << "\n";
  std::cout << "gpu_ms_per_rep=" << gpu_ms_per_rep << "\n";
  std::cout << "cpu_ms_per_rep=" << cpu_ms_per_rep << "\n";
  if (hybridMode == "off") {
    if (!kSimAccelSkipCpuReferenceBuild) {
      std::cout << "speedup_gpu_over_cpu=" << speedup << "x\n";
    } else {
      std::cout << "speedup_gpu_over_cpu=skipped\n";
    }
  } else if (hybridMode == "single-partition") {
    std::cout << "hybrid_partition_index=" << hybridPartitionIndex << "\n";
    std::cout << "hybrid_partition_assign_count="
              << sim_accel_eval_partition_assign_count(hybridPartitionIndex) << "\n";
    std::cout << "hybrid_partition_read_vars=" << hybridReadVarIdxs.size() << "\n";
    std::cout << "hybrid_partition_write_vars=" << hybridWriteVarIdxs.size() << "\n";
    std::cout << "hybrid_partition_input_bytes_per_batch=" << hybridBoundaryInputBytes << "\n";
    std::cout << "hybrid_partition_output_bytes_per_batch=" << hybridBoundaryOutputBytes << "\n";
    std::cout << "hybrid_static_h2d_bytes_per_batch=" << hybridStaticH2dBytes << "\n";
    std::cout << "hybrid_dynamic_h2d_bytes_per_batch=" << hybridDynamicH2dBytes << "\n";
    std::cout << "hybrid_actual_h2d_bytes_per_batch=" << hybridActualH2dBytes << "\n";
    std::cout << "hybrid_actual_d2h_bytes_per_batch=" << hybridActualD2hBytes << "\n";
    std::cout << "hybrid_setup_h2d_ms=" << hybrid_setup_h2d_ms << "\n";
    std::cout << "hybrid_dynamic_h2d_ms_per_rep=" << hybrid_dynamic_h2d_ms_per_rep << "\n";
    std::cout << "hybrid_kernel_ms_per_rep=" << hybrid_kernel_ms_per_rep << "\n";
    std::cout << "hybrid_d2h_ms_per_rep=" << hybrid_d2h_ms_per_rep << "\n";
    std::cout << "hybrid_transfer_ms_per_rep=" << hybrid_transfer_ms_per_rep << "\n";
    std::cout << "hybrid_cpu_dispatch_ms_per_rep=" << hybrid_cpu_dispatch_ms_per_rep << "\n";
    std::cout << "hybrid_gpu_ms_per_rep=" << hybrid_ms_per_rep << "\n";
    std::cout << "hybrid_cpu_ms_per_rep=" << hybrid_cpu_ms_per_rep << "\n";
    std::cout << "hybrid_mismatch=" << hybridMismatch << "\n";
  } else if (hybridMode == "single-cluster") {
    std::cout << "hybrid_cluster_index=" << hybridClusterIndex << "\n";
    std::cout << "hybrid_cluster_auto=" << (hybridClusterAuto ? 1 : 0) << "\n";
    std::cout << "hybrid_cluster_auto_max_input_bits=" << hybridClusterAutoMaxInputBits << "\n";
    std::cout << "hybrid_cluster_auto_candidate_count=" << hybridClusterAutoCandidateCount << "\n";
    std::cout << "hybrid_cluster_auto_fallback_used="
              << (hybridClusterAutoFallbackUsed ? 1 : 0) << "\n";
    std::cout << "hybrid_cluster_auto_selected_owner_hint="
              << hybridClusterAutoSelectedOwnerHint << "\n";
    std::cout << "hybrid_cluster_assign_count="
              << sim_accel_eval_cluster_assign_count(hybridClusterIndex) << "\n";
    std::cout << "hybrid_cluster_input_signature_bits="
              << sim_accel_eval_cluster_input_signature_bits(hybridClusterIndex) << "\n";
    std::cout << "hybrid_cluster_owner_hint="
              << sim_accel_eval_cluster_owner_hint(hybridClusterIndex) << "\n";
    std::cout << "hybrid_cluster_read_vars=" << hybridReadVarIdxs.size() << "\n";
    std::cout << "hybrid_cluster_write_vars=" << hybridWriteVarIdxs.size() << "\n";
    std::cout << "hybrid_cluster_input_bytes_per_batch=" << hybridBoundaryInputBytes << "\n";
    std::cout << "hybrid_cluster_output_bytes_per_batch=" << hybridBoundaryOutputBytes << "\n";
    std::cout << "hybrid_static_h2d_bytes_per_batch=" << hybridStaticH2dBytes << "\n";
    std::cout << "hybrid_dynamic_h2d_bytes_per_batch=" << hybridDynamicH2dBytes << "\n";
    std::cout << "hybrid_actual_h2d_bytes_per_batch=" << hybridActualH2dBytes << "\n";
    std::cout << "hybrid_actual_d2h_bytes_per_batch=" << hybridActualD2hBytes << "\n";
    std::cout << "hybrid_setup_h2d_ms=" << hybrid_setup_h2d_ms << "\n";
    std::cout << "hybrid_dynamic_h2d_ms_per_rep=" << hybrid_dynamic_h2d_ms_per_rep << "\n";
    std::cout << "hybrid_kernel_ms_per_rep=" << hybrid_kernel_ms_per_rep << "\n";
    std::cout << "hybrid_d2h_ms_per_rep=" << hybrid_d2h_ms_per_rep << "\n";
    std::cout << "hybrid_transfer_ms_per_rep=" << hybrid_transfer_ms_per_rep << "\n";
    std::cout << "hybrid_cpu_dispatch_ms_per_rep=" << hybrid_cpu_dispatch_ms_per_rep << "\n";
    std::cout << "hybrid_gpu_ms_per_rep=" << hybrid_ms_per_rep << "\n";
    std::cout << "hybrid_cpu_ms_per_rep=" << hybrid_cpu_ms_per_rep << "\n";
    std::cout << "hybrid_mismatch=" << hybridMismatch << "\n";
  } else {
    std::cout << "hybrid_cluster_indices=" << hybridClusterIndicesCsv << "\n";
    std::cout << "hybrid_cluster_group_size=" << hybridClusterIndices.size() << "\n";
    std::cout << "hybrid_cluster_group_assign_count=" << hybridClusterGroupAssignCount << "\n";
    std::cout << "hybrid_cluster_group_input_signature_bits="
              << hybridClusterGroupInputSignatureBits << "\n";
    std::cout << "hybrid_cluster_read_vars=" << hybridReadVarIdxs.size() << "\n";
    std::cout << "hybrid_cluster_write_vars=" << hybridWriteVarIdxs.size() << "\n";
    std::cout << "hybrid_cluster_input_bytes_per_batch=" << hybridBoundaryInputBytes << "\n";
    std::cout << "hybrid_cluster_output_bytes_per_batch=" << hybridBoundaryOutputBytes << "\n";
    std::cout << "hybrid_static_h2d_bytes_per_batch=" << hybridStaticH2dBytes << "\n";
    std::cout << "hybrid_dynamic_h2d_bytes_per_batch=" << hybridDynamicH2dBytes << "\n";
    std::cout << "hybrid_actual_h2d_bytes_per_batch=" << hybridActualH2dBytes << "\n";
    std::cout << "hybrid_actual_d2h_bytes_per_batch=" << hybridActualD2hBytes << "\n";
    std::cout << "hybrid_setup_h2d_ms=" << hybrid_setup_h2d_ms << "\n";
    std::cout << "hybrid_dynamic_h2d_ms_per_rep=" << hybrid_dynamic_h2d_ms_per_rep << "\n";
    std::cout << "hybrid_kernel_ms_per_rep=" << hybrid_kernel_ms_per_rep << "\n";
    std::cout << "hybrid_d2h_ms_per_rep=" << hybrid_d2h_ms_per_rep << "\n";
    std::cout << "hybrid_transfer_ms_per_rep=" << hybrid_transfer_ms_per_rep << "\n";
    std::cout << "hybrid_cpu_dispatch_ms_per_rep=" << hybrid_cpu_dispatch_ms_per_rep << "\n";
    std::cout << "hybrid_gpu_ms_per_rep=" << hybrid_ms_per_rep << "\n";
    std::cout << "hybrid_cpu_ms_per_rep=" << hybrid_cpu_ms_per_rep << "\n";
    std::cout << "hybrid_mismatch=" << hybridMismatch << "\n";
  }
  std::cout << "mismatch=" << mismatch << "\n";
  std::cout << "compact_mismatch=" << compactMismatch << "\n";
  std::cout << "comm_input_vars=" << inputVarIdxs.size() << "\n";
  std::cout << "comm_output_vars=" << outputVarIdxs.size() << "\n";
  std::cout << "comm_index_bytes_static=" << commIndexBytes << "\n";
  std::cout << "comm_input_bytes_per_batch=" << compactInputBytes << "\n";
  std::cout << "comm_output_bytes_per_batch=" << compactOutputBytes << "\n";
  std::cout << "comm_total_bytes_per_batch=" << compactRoundtripBytes << "\n";
  std::cout << "comm_full_roundtrip_bytes=" << fullRoundtripBytes << "\n";
  std::cout << "comm_verify_full_d2h_bytes=" << bytes << "\n";
  if (fullRoundtripBytes != 0) {
    const double ratio = (100.0 * static_cast<double>(compactRoundtripBytes))
                         / static_cast<double>(fullRoundtripBytes);
    std::cout << "comm_roundtrip_ratio_pct=" << ratio << "\n";
  }
  if (hybridMode == "off") {
    if (speedup > (1.0 + eps)) {
      std::cout << "auto_parallel_judgement=parallel\n";
      std::cout << "auto_engine_recommendation=gpu\n";
    } else if (speedup < (1.0 - eps)) {
      std::cout << "auto_parallel_judgement=non_parallel\n";
      std::cout << "auto_engine_recommendation=cpu\n";
    } else {
      std::cout << "auto_parallel_judgement=borderline\n";
      std::cout << "auto_engine_recommendation=tie\n";
    }
  } else {
    std::cout << "auto_parallel_judgement=hybrid\n";
    std::cout << "auto_engine_recommendation=hybrid\n";
  }

  if (d_inputVarIdxs) cudaFree(d_inputVarIdxs);
  if (d_outputVarIdxs) cudaFree(d_outputVarIdxs);
  if (d_in_compact) cudaFree(d_in_compact);
  if (d_out_compact) cudaFree(d_out_compact);
  if (d_hybridInputVarIdxs) cudaFree(d_hybridInputVarIdxs);
  if (d_hybridInputCompact) cudaFree(d_hybridInputCompact);
  if (d_hybridReadOutputVarIdxs) cudaFree(d_hybridReadOutputVarIdxs);
  if (d_hybridReadOutputCompact) cudaFree(d_hybridReadOutputCompact);
  if (d_hybridWriteVarIdxs) cudaFree(d_hybridWriteVarIdxs);
  if (d_hybridWriteCompact) cudaFree(d_hybridWriteCompact);
  cudaFree(d_in);
  cudaFree(d_out);
  if (hybridMode == "off") {
    return kSimAccelSkipCpuReferenceBuild ? 0 : (mismatch == 0 ? 0 : 1);
  }
  return hybridMismatch == 0 ? 0 : 1;
}
CU

cp "$KERNEL_CU" "$OUTDIR/kernel_generated.cu"
cp "$KERNEL_VARS" "$OUTDIR/kernel_generated.vars.tsv"
if [[ -s "$KERNEL_COMM" ]]; then
  cp "$KERNEL_COMM" "$OUTDIR/kernel_generated.comm.tsv"
fi
if [[ -f "$KERNEL_API" ]]; then
  cp "$KERNEL_API" "$OUTDIR/kernel_generated.api.h"
fi
if [[ -f "$KERNEL_CPU" ]]; then
  cp "$KERNEL_CPU" "$OUTDIR/kernel_generated.cpu.cpp"
fi
if [[ -f "$KERNEL_LINK" ]]; then
  cp "$KERNEL_LINK" "$OUTDIR/kernel_generated.link.cu"
fi
if [[ -f "$KERNEL_PARTITIONS" ]]; then
  cp "$KERNEL_PARTITIONS" "$OUTDIR/kernel_generated.partitions.tsv"
fi
if [[ -f "$KERNEL_CLUSTERS" ]]; then
  cp "$KERNEL_CLUSTERS" "$OUTDIR/kernel_generated.clusters.tsv"
fi
rm -f "$OUTDIR"/kernel_generated.part*.cu
rm -f "$OUTDIR"/kernel_generated.cluster*.cu
while IFS= read -r generated_part; do
  cp "$generated_part" "$OUTDIR/kernel_generated.${generated_part##*.kernel.cu.}"
done < <(find "$OUTDIR" -maxdepth 1 -type f \
  \( -name "$(basename "$KERNEL_CU").part*.cu" -o -name "$(basename "$KERNEL_CU").cluster*.cu" \) \
  | LC_ALL=C sort)

USE_PARTITION_OBJECTS=0
declare -a PARTITION_SOURCES=()
declare -a CLUSTER_SOURCES=()
HYBRID_BUILD_CLUSTER_INDEX=""
HYBRID_BUILD_CLUSTER_INDICES=""
HYBRID_BUILD_CLUSTER_OWNER_HINT=""
HYBRID_BUILD_CLUSTER_FALLBACK=0
HYBRID_BUILD_CLUSTER_GROUP_AUTO=0
HYBRID_BUILD_CLUSTER_GROUP_CANDIDATE_COUNT=0
HYBRID_BUILD_CLUSTER_GROUP_STATIC_SCORE=""
HYBRID_BUILD_CLUSTER_GROUP_WEIGHTED_OPS=""
HYBRID_BUILD_CLUSTER_GROUP_INPUT_BITS=""
HYBRID_BUILD_CLUSTER_GROUP_ASSIGN_COUNT=""
if [[ -f "$OUTDIR/kernel_generated.api.h" && -f "$OUTDIR/kernel_generated.link.cu" ]] \
   && ([[ "$SKIP_CPU_REFERENCE_BUILD" -ne 0 ]] || [[ -f "$OUTDIR/kernel_generated.cpu.cpp" ]]); then
  mapfile -t PARTITION_SOURCES < <(find "$OUTDIR" -maxdepth 1 -type f -name 'kernel_generated.part*.cu' | LC_ALL=C sort)
  mapfile -t CLUSTER_SOURCES < <(find "$OUTDIR" -maxdepth 1 -type f -name 'kernel_generated.cluster*.cu' | LC_ALL=C sort)
  if (( ${#PARTITION_SOURCES[@]} > 0 || ${#CLUSTER_SOURCES[@]} > 0 )); then
    USE_PARTITION_OBJECTS=1
  fi
fi

BENCH_CUDA_EXTRA_FLAGS=""
if [[ "$SKIP_CPU_REFERENCE_BUILD" -ne 0 ]]; then
  BENCH_CUDA_EXTRA_FLAGS="-DSIM_ACCEL_SKIP_CPU_REFERENCE_BUILD=1"
fi

if [[ "$HYBRID_MODE" == "single-cluster" && "$USE_PARTITION_OBJECTS" -eq 1 ]]; then
  if [[ "$HYBRID_CLUSTER_AUTO" -eq 1 ]]; then
    if [[ ! -f "$OUTDIR/kernel_generated.clusters.tsv" ]]; then
      echo "Missing cluster metadata for --hybrid-cluster-auto: $OUTDIR/kernel_generated.clusters.tsv" >&2
      exit 2
    fi
    if ! auto_cluster_selection="$(select_auto_hybrid_cluster_from_tsv \
      "$OUTDIR/kernel_generated.clusters.tsv" "$HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS")"; then
      echo "No suitable hybrid cluster found for auto-selection (max_input_bits=$HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS)" >&2
      exit 2
    fi
    IFS=$'\t' read -r HYBRID_BUILD_CLUSTER_INDEX _ HYBRID_BUILD_CLUSTER_FALLBACK \
      HYBRID_BUILD_CLUSTER_OWNER_HINT <<<"$auto_cluster_selection"
  else
    HYBRID_BUILD_CLUSTER_INDEX="$HYBRID_CLUSTER_INDEX"
    if [[ -f "$OUTDIR/kernel_generated.clusters.tsv" ]]; then
      HYBRID_BUILD_CLUSTER_OWNER_HINT="$(awk -F '\t' -v idx="$HYBRID_BUILD_CLUSTER_INDEX" \
        'NR > 1 && $1 == idx { print $7; exit }' "$OUTDIR/kernel_generated.clusters.tsv")"
    fi
  fi
  selected_cluster_src="$OUTDIR/kernel_generated.cluster${HYBRID_BUILD_CLUSTER_INDEX}.cu"
  if [[ ! -f "$selected_cluster_src" ]]; then
    echo "Missing generated source for selected hybrid cluster: $selected_cluster_src" >&2
    exit 2
  fi
  prepare_single_cluster_link_source "$OUTDIR/kernel_generated.link.cu" "$HYBRID_BUILD_CLUSTER_INDEX"
  CLUSTER_SOURCES=("$selected_cluster_src")
  HYBRID_BUILD_CLUSTER_INDICES="$HYBRID_BUILD_CLUSTER_INDEX"
elif [[ "$HYBRID_MODE" == "cluster-group" && "$USE_PARTITION_OBJECTS" -eq 1 ]]; then
  if [[ "$HYBRID_CLUSTER_GROUP_AUTO" -eq 1 ]]; then
    if [[ ! -f "$OUTDIR/kernel_generated.clusters.tsv" ]]; then
      echo "Missing cluster metadata for --hybrid-cluster-group-auto: $OUTDIR/kernel_generated.clusters.tsv" >&2
      exit 2
    fi
    if ! auto_group_selection="$(select_auto_hybrid_cluster_group_from_tsv \
      "$OUTDIR/kernel_generated.clusters.tsv" "$HYBRID_CLUSTER_GROUP_SIZE" \
      "$HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS")"; then
      echo "No suitable hybrid cluster group found for auto-selection" \
           " (group_size=$HYBRID_CLUSTER_GROUP_SIZE, max_input_bits=$HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS)" >&2
      exit 2
    fi
    IFS=$'\t' read -r HYBRID_CLUSTER_INDICES HYBRID_BUILD_CLUSTER_GROUP_CANDIDATE_COUNT \
      HYBRID_BUILD_CLUSTER_FALLBACK HYBRID_BUILD_CLUSTER_OWNER_HINT HYBRID_BUILD_CLUSTER_GROUP_STATIC_SCORE \
      HYBRID_BUILD_CLUSTER_GROUP_WEIGHTED_OPS HYBRID_BUILD_CLUSTER_GROUP_INPUT_BITS \
      HYBRID_BUILD_CLUSTER_GROUP_ASSIGN_COUNT <<<"$auto_group_selection"
    HYBRID_BUILD_CLUSTER_GROUP_AUTO=1
  fi
  HYBRID_BUILD_CLUSTER_INDICES="$HYBRID_CLUSTER_INDICES"
  declare -a SELECTED_CLUSTER_SOURCES=()
  IFS=',' read -r -a HYBRID_GROUP_CLUSTER_ARRAY <<<"$HYBRID_CLUSTER_INDICES"
  for cluster_idx in "${HYBRID_GROUP_CLUSTER_ARRAY[@]}"; do
    selected_cluster_src="$OUTDIR/kernel_generated.cluster${cluster_idx}.cu"
    if [[ ! -f "$selected_cluster_src" ]]; then
      echo "Missing generated source for selected hybrid cluster: $selected_cluster_src" >&2
      exit 2
    fi
    SELECTED_CLUSTER_SOURCES+=("$selected_cluster_src")
  done
  prepare_cluster_group_link_source "$OUTDIR/kernel_generated.link.cu" "$HYBRID_CLUSTER_INDICES"
  CLUSTER_SOURCES=("${SELECTED_CLUSTER_SOURCES[@]}")
elif [[ "$USE_PARTITION_OBJECTS" -eq 1 ]]; then
  prepare_no_cluster_link_source "$OUTDIR/kernel_generated.link.cu"
  CLUSTER_SOURCES=()
fi

BENCH_GENERATED_INCLUDE="kernel_generated.cu"
if [[ "$USE_PARTITION_OBJECTS" -eq 1 ]]; then
  BENCH_GENERATED_INCLUDE="kernel_generated.api.h"
fi
sed -i "s#__SIM_ACCEL_GENERATED_INCLUDE__#${BENCH_GENERATED_INCLUDE}#" "$OUTDIR/bench_kernel.cu"

NVCC_CACHE_MODE="disabled"
NVCC_CACHE_KEY=""
NVCC_COLD_COMPILE_S=""

if [[ "$COMPILE_CACHE_ENABLED" -eq 1 ]]; then
  NVCC_CACHE_KEY="$(compute_compile_cache_key)"
  CACHE_ENTRY="$COMPILE_CACHE_DIR/$NVCC_CACHE_KEY"
  CACHE_BIN="$CACHE_ENTRY/bench_kernel"
  CACHE_LOG="$CACHE_ENTRY/build_nvcc.log"
  CACHE_TIME="$CACHE_ENTRY/compile_s.txt"
  if [[ -x "$CACHE_BIN" ]]; then
    echo "[3/4] Reusing cached CUDA benchmark..."
    cp "$CACHE_BIN" "$OUTDIR/bench_kernel"
    chmod +x "$OUTDIR/bench_kernel"
    if [[ -f "$CACHE_LOG" ]]; then
      cp "$CACHE_LOG" "$OUTDIR/build_nvcc.log"
    else
      : > "$OUTDIR/build_nvcc.log"
    fi
    if [[ -f "$CACHE_TIME" ]]; then
      NVCC_COLD_COMPILE_S="$(cat "$CACHE_TIME")"
    fi
    printf '0.000000\n' > "$TIME_NVCC"
    NVCC_CACHE_MODE="hit"
  else
    echo "[3/4] Building C++-direct CUDA benchmark..."
    if [[ "$USE_PARTITION_OBJECTS" -eq 1 ]]; then
      BUILD_START="$(date +%s.%N)"
      OLD_PWD_SIM_ACCEL="$PWD"
      cd "$OUTDIR"
      OBJ_DIR=".sim_accel_obj"
      rm -rf "$OBJ_DIR"
      mkdir -p "$OBJ_DIR"
      {
        build_cached_cuda_object "bench_kernel.cu" "$OBJ_DIR/bench_kernel.o" "$BENCH_CUDA_EXTRA_FLAGS"
        build_cached_cuda_object "kernel_generated.link.cu" "$OBJ_DIR/kernel_generated.link.o"
        declare -a PARTITION_OBJECTS=()
        for src in "${PARTITION_SOURCES[@]}"; do
          obj="$OBJ_DIR/$(basename "$src").o"
          build_cached_cuda_object "$src" "$obj"
          PARTITION_OBJECTS+=("$obj")
        done
        for src in "${CLUSTER_SOURCES[@]}"; do
          obj="$OBJ_DIR/$(basename "$src").o"
          build_cached_cuda_object "$src" "$obj"
          PARTITION_OBJECTS+=("$obj")
        done
        declare -a LINK_OBJECTS=("$OBJ_DIR/bench_kernel.o" "$OBJ_DIR/kernel_generated.link.o")
        if [[ "$SKIP_CPU_REFERENCE_BUILD" -eq 0 ]]; then
          build_cached_cxx_object "kernel_generated.cpu.cpp" "$OBJ_DIR/kernel_generated.cpu.o"
          LINK_OBJECTS+=("$OBJ_DIR/kernel_generated.cpu.o")
        fi
        nvcc -O3 -std=c++17 "${LINK_OBJECTS[@]}" "${PARTITION_OBJECTS[@]}" -o bench_kernel
      } > build_nvcc.log 2>&1
      cd "$OLD_PWD_SIM_ACCEL"
      BUILD_END="$(date +%s.%N)"
      awk -v s="$BUILD_START" -v e="$BUILD_END" 'BEGIN { printf "%.6f\n", e - s }' > "$TIME_NVCC"
    else
      (
        cd "$OUTDIR"
        /usr/bin/time -f "%e" -o "$TIME_NVCC" \
          nvcc -O3 -std=c++17 -DSIM_ACCEL_PARTIAL_WRITE=1 $BENCH_CUDA_EXTRA_FLAGS bench_kernel.cu -o bench_kernel > build_nvcc.log 2>&1
      )
    fi
    NVCC_CACHE_MODE="miss"
    NVCC_COLD_COMPILE_S="$(cat "$TIME_NVCC" 2>/dev/null || true)"
    TMP_CACHE_ENTRY="$COMPILE_CACHE_DIR/.tmp.$NVCC_CACHE_KEY.$$"
    rm -rf "$TMP_CACHE_ENTRY"
    mkdir -p "$TMP_CACHE_ENTRY"
    cp "$OUTDIR/bench_kernel" "$TMP_CACHE_ENTRY/bench_kernel"
    cp "$OUTDIR/build_nvcc.log" "$TMP_CACHE_ENTRY/build_nvcc.log"
    printf '%s\n' "$NVCC_COLD_COMPILE_S" > "$TMP_CACHE_ENTRY/compile_s.txt"
    {
      echo "cache_key=$NVCC_CACHE_KEY"
      echo "nvcc_version=$(nvcc --version | tr '\n' '|')"
      echo "generated_bundle_sha=$(compute_generated_compile_bundle_sha)"
      echo "bench_kernel_sha=$(sha256_one "$OUTDIR/bench_kernel.cu")"
    } > "$TMP_CACHE_ENTRY/meta.txt"
    if ! mv "$TMP_CACHE_ENTRY" "$CACHE_ENTRY" 2>/dev/null; then
      rm -rf "$TMP_CACHE_ENTRY"
    fi
  fi
else
  echo "[3/4] Building C++-direct CUDA benchmark..."
  if [[ "$USE_PARTITION_OBJECTS" -eq 1 ]]; then
    BUILD_START="$(date +%s.%N)"
    OLD_PWD_SIM_ACCEL="$PWD"
    cd "$OUTDIR"
    OBJ_DIR=".sim_accel_obj"
    rm -rf "$OBJ_DIR"
    mkdir -p "$OBJ_DIR"
    {
      build_cached_cuda_object "bench_kernel.cu" "$OBJ_DIR/bench_kernel.o" "$BENCH_CUDA_EXTRA_FLAGS"
      build_cached_cuda_object "kernel_generated.link.cu" "$OBJ_DIR/kernel_generated.link.o"
      declare -a PARTITION_OBJECTS=()
      for src in "${PARTITION_SOURCES[@]}"; do
        obj="$OBJ_DIR/$(basename "$src").o"
        build_cached_cuda_object "$src" "$obj"
        PARTITION_OBJECTS+=("$obj")
      done
      for src in "${CLUSTER_SOURCES[@]}"; do
        obj="$OBJ_DIR/$(basename "$src").o"
        build_cached_cuda_object "$src" "$obj"
        PARTITION_OBJECTS+=("$obj")
      done
      declare -a LINK_OBJECTS=("$OBJ_DIR/bench_kernel.o" "$OBJ_DIR/kernel_generated.link.o")
      if [[ "$SKIP_CPU_REFERENCE_BUILD" -eq 0 ]]; then
        build_cached_cxx_object "kernel_generated.cpu.cpp" "$OBJ_DIR/kernel_generated.cpu.o"
        LINK_OBJECTS+=("$OBJ_DIR/kernel_generated.cpu.o")
      fi
      nvcc -O3 -std=c++17 "${LINK_OBJECTS[@]}" "${PARTITION_OBJECTS[@]}" -o bench_kernel
    } > build_nvcc.log 2>&1
    cd "$OLD_PWD_SIM_ACCEL"
    BUILD_END="$(date +%s.%N)"
    awk -v s="$BUILD_START" -v e="$BUILD_END" 'BEGIN { printf "%.6f\n", e - s }' > "$TIME_NVCC"
  else
    (
      cd "$OUTDIR"
      /usr/bin/time -f "%e" -o "$TIME_NVCC" \
        nvcc -O3 -std=c++17 -DSIM_ACCEL_PARTIAL_WRITE=1 $BENCH_CUDA_EXTRA_FLAGS bench_kernel.cu -o bench_kernel > build_nvcc.log 2>&1
    )
  fi
fi

echo "[4/4] Running benchmark..."
(
  cd "$OUTDIR"
  BENCH_CMD=(./bench_kernel --nstates "$NSTATES" --gpu-reps "$GPU_REPS" --cpu-reps "$CPU_REPS"
             --init-mode "$INIT_MODE" --init-seed "$INIT_SEED"
             --state-chunk "$STATE_CHUNK" --block-size "$BLOCK_SIZE")
  if [[ "$HYBRID_MODE" == "single-partition" ]]; then
    BENCH_CMD+=(--hybrid-mode "$HYBRID_MODE" --hybrid-partition-index "$HYBRID_PARTITION_INDEX")
  elif [[ "$HYBRID_MODE" == "single-cluster" ]]; then
    BENCH_CMD+=(--hybrid-mode "$HYBRID_MODE")
    if [[ "$HYBRID_CLUSTER_AUTO" -eq 1 ]]; then
      BENCH_CMD+=(--hybrid-cluster-auto
                  --hybrid-cluster-auto-max-input-bits "$HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS")
    else
      BENCH_CMD+=(--hybrid-cluster-index "$HYBRID_CLUSTER_INDEX")
    fi
  elif [[ "$HYBRID_MODE" == "cluster-group" ]]; then
    BENCH_CMD+=(--hybrid-mode "$HYBRID_MODE" --hybrid-cluster-indices "$HYBRID_CLUSTER_INDICES")
  fi
  if [[ -n "$INIT_FILE_ABS" ]]; then
    BENCH_CMD+=(--init-file "$INIT_FILE_ABS")
  fi
  if ! /usr/bin/time -f "%e" -o "$TIME_RUN" "${BENCH_CMD[@]}" > bench_run.log 2>&1; then
    echo "Benchmark execution failed. Last lines from bench_run.log:" >&2
    tail -n 40 bench_run.log >&2 || true
    if rg -q "OS call failed or operation not supported on this OS" bench_run.log; then
      cat >&2 <<'EOF2'
Likely root cause: CUDA device calls are blocked in the current execution context.
If this is running under a sandboxed agent/session, rerun the same command outside the sandbox
or with elevated permissions that allow GPU device access.
EOF2
    fi
    exit 1
  fi
)

if [[ "$HYBRID_MODE" == "cluster-group" && "$HYBRID_BUILD_CLUSTER_GROUP_AUTO" -eq 1 ]]; then
  {
    echo "hybrid_cluster_group_auto=1"
    echo "hybrid_cluster_group_auto_group_size=$HYBRID_CLUSTER_GROUP_SIZE"
    echo "hybrid_cluster_group_auto_max_input_bits=$HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS"
    echo "hybrid_cluster_group_auto_candidate_count=$HYBRID_BUILD_CLUSTER_GROUP_CANDIDATE_COUNT"
    echo "hybrid_cluster_group_auto_fallback_used=$HYBRID_BUILD_CLUSTER_FALLBACK"
    echo "hybrid_cluster_group_auto_selected_owner_hint=$HYBRID_BUILD_CLUSTER_OWNER_HINT"
    echo "hybrid_cluster_group_auto_selected_static_score=$HYBRID_BUILD_CLUSTER_GROUP_STATIC_SCORE"
    echo "hybrid_cluster_group_auto_selected_weighted_ops=$HYBRID_BUILD_CLUSTER_GROUP_WEIGHTED_OPS"
    echo "hybrid_cluster_group_auto_selected_input_bits=$HYBRID_BUILD_CLUSTER_GROUP_INPUT_BITS"
    echo "hybrid_cluster_group_auto_selected_assign_count=$HYBRID_BUILD_CLUSTER_GROUP_ASSIGN_COUNT"
  } >> "$OUTDIR/bench_run.log"
fi

ASSIGNW_SUPPORTED_RAW="$(rg -o 'assignw_supported=[0-9A-Fa-f]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
ASSIGNW_TOTAL_RAW="$(rg -o 'assignw_total=[0-9A-Fa-f]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
ASSIGNW_IGNORED_RAW="$(rg -o 'assignw_ignored=[0-9A-Fa-f]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
ASSIGNW_OFFLOAD_PCT="$(rg -o 'assignw_offload_pct=[0-9]+\.[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_CLUSTER_COUNT="$(rg -o 'cluster_count=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_ASSIGN_COUNT="$(rg -o 'assign_count=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_BOUNDARY_INPUT_VARS="$(rg -o 'boundary_input_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_BOUNDARY_OUTPUT_VARS="$(rg -o 'boundary_output_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_INTERNAL_VARS="$(rg -o 'internal_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_UNIQUE_BOUNDARY_INPUT_VARS="$(rg -o 'unique_boundary_input_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_UNIQUE_BOUNDARY_OUTPUT_VARS="$(rg -o 'unique_boundary_output_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_ACTIVATOR_INPUT_VARS="$(rg -o 'activator_input_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_MAX_ASSIGNS="$(rg -o 'max_assigns=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_MAX_BOUNDARY_INPUT_VARS="$(rg -o 'max_boundary_input_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"
APPROX_REGCUT_MAX_BOUNDARY_OUTPUT_VARS="$(rg -o 'max_boundary_output_vars=[0-9]+' "$LOG" | tail -n1 | cut -d= -f2 || true)"

to_dec() {
  local v="${1:-}"
  if [[ -z "$v" ]]; then
    echo ""
    return
  fi
  if [[ "$v" =~ [A-Fa-f] ]]; then
    echo "$((16#$v))"
  else
    echo "$v"
  fi
}

ASSIGNW_SUPPORTED="$(to_dec "$ASSIGNW_SUPPORTED_RAW")"
ASSIGNW_TOTAL="$(to_dec "$ASSIGNW_TOTAL_RAW")"
ASSIGNW_IGNORED="$(to_dec "$ASSIGNW_IGNORED_RAW")"

if [[ -n "$ASSIGNW_SUPPORTED" && -n "$ASSIGNW_TOTAL" && -n "$ASSIGNW_OFFLOAD_PCT" ]]; then
  {
    echo "cuda_assignw_supported=$ASSIGNW_SUPPORTED"
    echo "cuda_assignw_total=$ASSIGNW_TOTAL"
    echo "cuda_assignw_ignored=$ASSIGNW_IGNORED"
    echo "cuda_assignw_offload_pct=$ASSIGNW_OFFLOAD_PCT"
    echo "cuda_assignw_offload_scope=post_lowering_assignw_nodes"
    echo "cuda_assignw_offload_basis=supported_assignw_div_total_assignw"
  } >> "$OUTDIR/bench_run.log"
fi

if [[ -n "$APPROX_REGCUT_CLUSTER_COUNT" ]]; then
  {
    echo "approx_regcut_cluster_count=$APPROX_REGCUT_CLUSTER_COUNT"
    echo "approx_regcut_assign_count=$APPROX_REGCUT_ASSIGN_COUNT"
    echo "approx_regcut_boundary_input_vars=$APPROX_REGCUT_BOUNDARY_INPUT_VARS"
    echo "approx_regcut_boundary_output_vars=$APPROX_REGCUT_BOUNDARY_OUTPUT_VARS"
    echo "approx_regcut_internal_vars=$APPROX_REGCUT_INTERNAL_VARS"
    echo "approx_regcut_unique_boundary_input_vars=$APPROX_REGCUT_UNIQUE_BOUNDARY_INPUT_VARS"
    echo "approx_regcut_unique_boundary_output_vars=$APPROX_REGCUT_UNIQUE_BOUNDARY_OUTPUT_VARS"
    echo "approx_regcut_activator_input_vars=$APPROX_REGCUT_ACTIVATOR_INPUT_VARS"
    echo "approx_regcut_max_assigns=$APPROX_REGCUT_MAX_ASSIGNS"
    echo "approx_regcut_max_boundary_input_vars=$APPROX_REGCUT_MAX_BOUNDARY_INPUT_VARS"
    echo "approx_regcut_max_boundary_output_vars=$APPROX_REGCUT_MAX_BOUNDARY_OUTPUT_VARS"
  } >> "$OUTDIR/bench_run.log"
fi

VERILATOR_GEN_S="$(cat "$TIME_VERILATOR" 2>/dev/null || true)"
NVCC_COMPILE_S="$(cat "$TIME_NVCC" 2>/dev/null || true)"
BENCH_RUN_S="$(cat "$TIME_RUN" 2>/dev/null || true)"
if [[ -z "$VERILATOR_COLD_GEN_S" ]]; then
  VERILATOR_COLD_GEN_S="$VERILATOR_GEN_S"
fi
if [[ -z "$NVCC_COLD_COMPILE_S" ]]; then
  NVCC_COLD_COMPILE_S="$NVCC_COMPILE_S"
fi
if [[ -n "$VERILATOR_GEN_S" && -n "$NVCC_COMPILE_S" && -n "$BENCH_RUN_S" && -n "$NVCC_COLD_COMPILE_S" && -n "$VERILATOR_COLD_GEN_S" ]]; then
  TOTAL_S="$(awk -v a="$VERILATOR_GEN_S" -v b="$NVCC_COMPILE_S" -v c="$BENCH_RUN_S" 'BEGIN { printf "%.6f", a + b + c }')"
  TOTAL_COLD_S="$(awk -v a="$VERILATOR_COLD_GEN_S" -v b="$NVCC_COLD_COMPILE_S" -v c="$BENCH_RUN_S" 'BEGIN { printf "%.6f", a + b + c }')"
  {
    echo "verilator_codegen_s=$VERILATOR_GEN_S"
    echo "verilator_codegen_cold_s=$VERILATOR_COLD_GEN_S"
    echo "verilator_artifact_cache_mode=$VERILATOR_ARTIFACT_CACHE_MODE"
    echo "verilator_artifact_cache_key=$VERILATOR_ARTIFACT_CACHE_KEY"
    echo "nvcc_compile_s=$NVCC_COMPILE_S"
    echo "nvcc_cold_compile_s=$NVCC_COLD_COMPILE_S"
    echo "nvcc_cache_mode=$NVCC_CACHE_MODE"
    echo "nvcc_cache_key=$NVCC_CACHE_KEY"
    if [[ "$COMPILE_CACHE_ENABLED" -eq 1 ]]; then
      echo "compile_cache_dir=$COMPILE_CACHE_DIR"
    fi
    echo "partition_object_build=$USE_PARTITION_OBJECTS"
    echo "object_cache_hits=$OBJECT_CACHE_HITS"
    echo "object_cache_misses=$OBJECT_CACHE_MISSES"
    echo "bench_run_s=$BENCH_RUN_S"
    echo "total_elapsed_s=$TOTAL_S"
    echo "total_elapsed_cold_s=$TOTAL_COLD_S"
  } >> "$OUTDIR/bench_run.log"
fi

if [[ -s "$KERNEL_DEPS" ]]; then
  DEPS_ROWS="$(( $(wc -l < "$KERNEL_DEPS") - 1 ))"
  echo "cuda_deps_rows=$DEPS_ROWS" >> "$OUTDIR/bench_run.log"
fi

append_partition_canonical_stats "$KERNEL_PARTITIONS" "$OUTDIR/bench_run.log"

echo "== C++ direct benchmark complete =="
echo "outdir: $OUTDIR"
echo "kernel: $KERNEL_CU"
echo "vars:   $KERNEL_VARS"
echo "log:    $LOG"
echo "run:    $OUTDIR/bench_run.log"
cat "$OUTDIR/bench_run.log"
