    done < <(find "$OUTDIR" -maxdepth 1 -type f \
      \( -name "$(basename "$KERNEL_CU").part*.cu" -o -name "$(basename "$KERNEL_CU").cluster*.cu" \) \
      | LC_ALL=C sort)
    cp "$LOG" "$TMP_ARTIFACT_CACHE_ENTRY/verilator_cuda.log"
    printf '%s\n' "$VERILATOR_COLD_GEN_S" > "$TMP_ARTIFACT_CACHE_ENTRY/codegen_s.txt"
    {
      echo "cache_key=$VERILATOR_ARTIFACT_CACHE_KEY"
