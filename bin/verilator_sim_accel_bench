    mkdir -p "$COMPILE_CACHE_DIR/artifacts"
    if ! mv "$TMP_ARTIFACT_CACHE_ENTRY" "$ARTIFACT_CACHE_ENTRY" 2>/dev/null; then
      rm -rf "$TMP_ARTIFACT_CACHE_ENTRY"
