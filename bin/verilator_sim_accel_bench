#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

usage() {
  cat <<EOF2
Usage:
  ${SCRIPT_NAME} --top-module TOP --outdir DIR [options] -- <rtl files...>

Options:
  --verilator PATH     Verilator binary (default: ./bin/verilator)
  --top-module TOP     Top module name
  --outdir DIR         Output directory
  --nstates N          Number of parallel states (default: 131072)
  --state-chunk N      States per kernel launch chunk (default: nstates, 0=disabled)
  --gpu-reps N         GPU repetitions for timing (default: 200)
  --cpu-reps N         CPU repetitions for timing (default: 20)
  --block-size N       CUDA block size (default: 256)
  --init-mode MODE     Initial state mode: random|zero|ones|counter (default: random)
  --init-seed N        Seed for random init mode (default: 1)
  --init-file PATH     Optional init override file (index/name based)
  --assigns-per-kernel N  Limit emitted assigns per generated CUDA kernel partition (default: 0)
  --hybrid-mode MODE   Runtime path: off|single-partition|single-cluster|cluster-group (default: off)
  --hybrid-partition-index N  Selected partition for --hybrid-mode single-partition
  --hybrid-cluster-index N  Selected cluster for --hybrid-mode single-cluster
  --hybrid-cluster-indices LIST
                         Comma-separated cluster indices for --hybrid-mode cluster-group
  --hybrid-cluster-auto  Auto-select cluster for --hybrid-mode single-cluster
  --hybrid-cluster-auto-max-input-bits N
                         Max input-signature bits for auto-selected cluster (default: 128)
  --hybrid-cluster-group-auto
                         Auto-select contiguous cluster group for --hybrid-mode cluster-group
  --hybrid-cluster-group-size N
                         Group size for --hybrid-cluster-group-auto (default: 3)
  --hybrid-cluster-group-auto-max-input-bits N
                         Max summed input-signature bits for auto-selected cluster group (default: 128)
  --compile-cache-dir DIR  Reuse compiled bench binaries across runs
                           (default: /tmp/verilator-sim-accel-compile-cache)
  --no-compile-cache   Disable compiled bench cache reuse
  --skip-cpu-reference-build
                        Skip building/checking generated CPU reference
                        (requires --hybrid-mode off)

Init file format:
  - Comment lines start with '#'
  - Each line is one of:
      <var_index> <value>
      <var_name> <value>
      <var_index> <state_index> <value>
      <var_name> <state_index> <value>
  - Decimal and hex (0x...) are accepted

Example:
  ${SCRIPT_NAME} \
    --verilator ./bin/verilator \
    --top-module axi_interconnect \
    --outdir /tmp/sim_accel_bench \
    --init-mode counter \
    --init-file /tmp/ddr_init.txt \
    -- /path/to/priority_encoder.v /path/to/arbiter.v /path/to/axi_interconnect.v
EOF2
}

VERILATOR_BIN="./bin/verilator"
TOP_MODULE=""
OUTDIR=""
NSTATES=131072
STATE_CHUNK=0
GPU_REPS=200
CPU_REPS=20
BLOCK_SIZE=256
INIT_MODE="random"
INIT_SEED=1
INIT_FILE=""
INIT_FILE_ABS=""
ASSIGNS_PER_KERNEL=0
HYBRID_MODE="off"
HYBRID_PARTITION_INDEX=""
HYBRID_CLUSTER_INDEX=""
HYBRID_CLUSTER_INDICES=""
HYBRID_CLUSTER_AUTO=0
HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS=128
HYBRID_CLUSTER_GROUP_AUTO=0
HYBRID_CLUSTER_GROUP_SIZE=3
HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS=128
COMPILE_CACHE_DIR="${SIM_ACCEL_COMPILE_CACHE_DIR:-/tmp/verilator-sim-accel-compile-cache}"
COMPILE_CACHE_ENABLED=1
SKIP_CPU_REFERENCE_BUILD=0
declare -a SOURCES=()
INVOCATION_CWD="$(pwd)"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verilator)
      VERILATOR_BIN="$2"; shift 2 ;;
    --top-module)
      TOP_MODULE="$2"; shift 2 ;;
    --outdir)
      OUTDIR="$2"; shift 2 ;;
    --nstates)
      NSTATES="$2"; shift 2 ;;
    --state-chunk)
      STATE_CHUNK="$2"; shift 2 ;;
    --gpu-reps)
      GPU_REPS="$2"; shift 2 ;;
    --cpu-reps)
      CPU_REPS="$2"; shift 2 ;;
    --block-size)
      BLOCK_SIZE="$2"; shift 2 ;;
    --init-mode)
      INIT_MODE="$2"; shift 2 ;;
    --init-seed)
      INIT_SEED="$2"; shift 2 ;;
    --init-file)
      INIT_FILE="$2"; shift 2 ;;
    --assigns-per-kernel)
      ASSIGNS_PER_KERNEL="$2"; shift 2 ;;
    --hybrid-mode)
      HYBRID_MODE="$2"; shift 2 ;;
    --hybrid-partition-index)
      HYBRID_PARTITION_INDEX="$2"; shift 2 ;;
    --hybrid-cluster-index)
      HYBRID_CLUSTER_INDEX="$2"; shift 2 ;;
    --hybrid-cluster-indices)
      HYBRID_CLUSTER_INDICES="$2"; shift 2 ;;
    --hybrid-cluster-auto)
      HYBRID_CLUSTER_AUTO=1; shift ;;
    --hybrid-cluster-auto-max-input-bits)
      HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS="$2"; shift 2 ;;
    --hybrid-cluster-group-auto)
      HYBRID_CLUSTER_GROUP_AUTO=1; shift ;;
    --hybrid-cluster-group-size)
      HYBRID_CLUSTER_GROUP_SIZE="$2"; shift 2 ;;
    --hybrid-cluster-group-auto-max-input-bits)
      HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS="$2"; shift 2 ;;
    --compile-cache-dir)
      COMPILE_CACHE_DIR="$2"; shift 2 ;;
    --no-compile-cache)
      COMPILE_CACHE_ENABLED=0; shift ;;
    --skip-cpu-reference-build)
      SKIP_CPU_REFERENCE_BUILD=1; shift ;;
    --help|-h)
      usage; exit 0 ;;
    --)
      shift
      SOURCES=("$@")
      break ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2 ;;
  esac
done

if [[ -z "$TOP_MODULE" || -z "$OUTDIR" || ${#SOURCES[@]} -eq 0 ]]; then
  usage >&2
  exit 2
fi

if ! [[ "$STATE_CHUNK" =~ ^[0-9]+$ ]]; then
  echo "Invalid --state-chunk: $STATE_CHUNK (expected integer >= 0)" >&2
  exit 2
fi
if ! [[ "$NSTATES" =~ ^[0-9]+$ ]] || [[ "$NSTATES" -eq 0 ]]; then
  echo "Invalid --nstates: $NSTATES (expected integer > 0)" >&2
  exit 2
fi
if [[ "$STATE_CHUNK" -gt "$NSTATES" ]]; then
  STATE_CHUNK="$NSTATES"
fi
if ! [[ "$BLOCK_SIZE" =~ ^[0-9]+$ ]] || [[ "$BLOCK_SIZE" -eq 0 ]] || [[ "$BLOCK_SIZE" -gt 1024 ]]; then
  echo "Invalid --block-size: $BLOCK_SIZE (expected integer in 1..1024)" >&2
  exit 2
fi
if ! [[ "$ASSIGNS_PER_KERNEL" =~ ^[0-9]+$ ]]; then
  echo "Invalid --assigns-per-kernel: $ASSIGNS_PER_KERNEL (expected integer >= 0)" >&2
  exit 2
fi
if ! [[ "$HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS" =~ ^[0-9]+$ ]]; then
  echo "Invalid --hybrid-cluster-auto-max-input-bits: $HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS (expected integer >= 0)" >&2
  exit 2
fi
if ! [[ "$HYBRID_CLUSTER_GROUP_SIZE" =~ ^[0-9]+$ ]] || [[ "$HYBRID_CLUSTER_GROUP_SIZE" -eq 0 ]]; then
  echo "Invalid --hybrid-cluster-group-size: $HYBRID_CLUSTER_GROUP_SIZE (expected integer > 0)" >&2
  exit 2
fi
if ! [[ "$HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS" =~ ^[0-9]+$ ]]; then
  echo "Invalid --hybrid-cluster-group-auto-max-input-bits: $HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS (expected integer >= 0)" >&2
  exit 2
fi
case "$HYBRID_MODE" in
  off|single-partition|single-cluster|cluster-group) ;;
  *)
    echo "Invalid --hybrid-mode: $HYBRID_MODE (expected off|single-partition|single-cluster|cluster-group)" >&2
    exit 2 ;;
esac
if [[ "$HYBRID_MODE" == "single-partition" ]]; then
  if [[ -z "$HYBRID_PARTITION_INDEX" ]]; then
    echo "--hybrid-partition-index is required with --hybrid-mode single-partition" >&2
    exit 2
  fi
  if ! [[ "$HYBRID_PARTITION_INDEX" =~ ^[0-9]+$ ]]; then
    echo "Invalid --hybrid-partition-index: $HYBRID_PARTITION_INDEX (expected integer >= 0)" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDEX" ]]; then
    echo "--hybrid-cluster-index requires --hybrid-mode single-cluster" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDICES" ]]; then
    echo "--hybrid-cluster-indices requires --hybrid-mode cluster-group" >&2
    exit 2
  fi
elif [[ "$HYBRID_MODE" == "single-cluster" ]]; then
  if [[ -n "$HYBRID_CLUSTER_INDEX" && "$HYBRID_CLUSTER_AUTO" -eq 1 ]]; then
    echo "--hybrid-cluster-index and --hybrid-cluster-auto are mutually exclusive" >&2
    exit 2
  fi
  if [[ -z "$HYBRID_CLUSTER_INDEX" && "$HYBRID_CLUSTER_AUTO" -eq 0 ]]; then
    echo "--hybrid-cluster-index or --hybrid-cluster-auto is required with --hybrid-mode single-cluster" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDEX" ]] && ! [[ "$HYBRID_CLUSTER_INDEX" =~ ^[0-9]+$ ]]; then
    echo "Invalid --hybrid-cluster-index: $HYBRID_CLUSTER_INDEX (expected integer >= 0)" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_PARTITION_INDEX" ]]; then
    echo "--hybrid-partition-index requires --hybrid-mode single-partition" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDICES" ]]; then
    echo "--hybrid-cluster-indices requires --hybrid-mode cluster-group" >&2
    exit 2
  fi
  if [[ "$HYBRID_CLUSTER_GROUP_AUTO" -ne 0 ]]; then
    echo "--hybrid-cluster-group-auto requires --hybrid-mode cluster-group" >&2
    exit 2
  fi
elif [[ "$HYBRID_MODE" == "cluster-group" ]]; then
  if [[ -n "$HYBRID_CLUSTER_INDICES" && "$HYBRID_CLUSTER_GROUP_AUTO" -ne 0 ]]; then
    echo "--hybrid-cluster-indices and --hybrid-cluster-group-auto are mutually exclusive" >&2
    exit 2
  fi
  if [[ -z "$HYBRID_CLUSTER_INDICES" && "$HYBRID_CLUSTER_GROUP_AUTO" -eq 0 ]]; then
    echo "--hybrid-cluster-indices or --hybrid-cluster-group-auto is required with --hybrid-mode cluster-group" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDICES" ]] && ! [[ "$HYBRID_CLUSTER_INDICES" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    echo "Invalid --hybrid-cluster-indices: $HYBRID_CLUSTER_INDICES (expected comma-separated integers)" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDICES" ]]; then
    declare -A seen_hybrid_cluster_indices=()
    IFS=',' read -r -a hybrid_cluster_tokens <<<"$HYBRID_CLUSTER_INDICES"
    for cluster_idx in "${hybrid_cluster_tokens[@]}"; do
      if [[ -n "${seen_hybrid_cluster_indices[$cluster_idx]:-}" ]]; then
        echo "Duplicate cluster index in --hybrid-cluster-indices: $cluster_idx" >&2
        exit 2
      fi
      seen_hybrid_cluster_indices[$cluster_idx]=1
    done
  fi
  if [[ -n "$HYBRID_PARTITION_INDEX" ]]; then
    echo "--hybrid-partition-index requires --hybrid-mode single-partition" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDEX" ]]; then
    echo "--hybrid-cluster-index requires --hybrid-mode single-cluster" >&2
    exit 2
  fi
  if [[ "$HYBRID_CLUSTER_AUTO" -ne 0 ]]; then
    echo "--hybrid-cluster-auto requires --hybrid-mode single-cluster" >&2
    exit 2
  fi
else
  if [[ -n "$HYBRID_PARTITION_INDEX" ]]; then
    echo "--hybrid-partition-index requires --hybrid-mode single-partition" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDEX" ]]; then
    echo "--hybrid-cluster-index requires --hybrid-mode single-cluster" >&2
    exit 2
  fi
  if [[ -n "$HYBRID_CLUSTER_INDICES" ]]; then
    echo "--hybrid-cluster-indices requires --hybrid-mode cluster-group" >&2
    exit 2
  fi
  if [[ "$HYBRID_CLUSTER_AUTO" -ne 0 ]]; then
    echo "--hybrid-cluster-auto requires --hybrid-mode single-cluster" >&2
    exit 2
  fi
  if [[ "$HYBRID_CLUSTER_GROUP_AUTO" -ne 0 ]]; then
    echo "--hybrid-cluster-group-auto requires --hybrid-mode cluster-group" >&2
    exit 2
  fi
fi
if [[ "$HYBRID_CLUSTER_AUTO" -eq 0 && "$HYBRID_CLUSTER_AUTO_MAX_INPUT_BITS" != "128" ]]; then
  echo "--hybrid-cluster-auto-max-input-bits requires --hybrid-cluster-auto" >&2
  exit 2
fi
if [[ "$HYBRID_CLUSTER_GROUP_AUTO" -eq 0 && "$HYBRID_CLUSTER_GROUP_SIZE" != "3" ]]; then
  echo "--hybrid-cluster-group-size requires --hybrid-cluster-group-auto" >&2
  exit 2
fi
if [[ "$HYBRID_CLUSTER_GROUP_AUTO" -eq 0 && "$HYBRID_CLUSTER_GROUP_AUTO_MAX_INPUT_BITS" != "128" ]]; then
  echo "--hybrid-cluster-group-auto-max-input-bits requires --hybrid-cluster-group-auto" >&2
  exit 2
fi
if [[ "$SKIP_CPU_REFERENCE_BUILD" -ne 0 && "$HYBRID_MODE" != "off" ]]; then
  echo "--skip-cpu-reference-build requires --hybrid-mode off" >&2
  exit 2
fi

case "$INIT_MODE" in
  random|zero|ones|counter) ;;
  *)
    echo "Invalid --init-mode: $INIT_MODE (expected random|zero|ones|counter)" >&2
    exit 2 ;;
esac

if [[ -n "$INIT_FILE" ]]; then
  if [[ ! -f "$INIT_FILE" ]]; then
    echo "--init-file not found: $INIT_FILE" >&2
    exit 2
  fi
  INIT_FILE_ABS="$(cd "$(dirname "$INIT_FILE")" && pwd)/$(basename "$INIT_FILE")"
fi

mkdir -p "$COMPILE_CACHE_DIR"
COMPILE_CACHE_DIR="$(cd "$COMPILE_CACHE_DIR" && pwd)"

sha256_one() {
  sha256sum "$1" | awk '{print $1}'
}

canonicalize_path() {
  local path="$1"
  local base="${2:-$INVOCATION_CWD}"
  if [[ "$path" == /* ]]; then
    realpath -m -- "$path"
  else
    realpath -m -- "$base/$path"
  fi
}

resolve_executable_path() {
  local exe="$1"
  if [[ "$exe" == */* ]]; then
    canonicalize_path "$exe" "$INVOCATION_CWD"
  else
    command -v -- "$exe"
  fi
}

emit_verilator_input_fingerprint() {
  local arg="$1"
  local base="$2"
  printf 'arg=%s\n' "$arg"
  case "$arg" in
    ""|--*|-*|+*)
      return 0
      ;;
  esac
  local abs
  abs="$(canonicalize_path "$arg" "$base")"
  printf 'file=%s\n' "$abs"
  if [[ -f "$abs" ]]; then
    printf 'file_sha=%s\n' "$(sha256_one "$abs")"
  else
    printf 'file_missing=1\n'
  fi
}

emit_filelist_fingerprint() {
  local filelist="$1"
  local base="$2"
  local abs
  abs="$(canonicalize_path "$filelist" "$base")"
  printf 'filelist=%s\n' "$abs"
  if [[ ! -f "$abs" ]]; then
    printf 'filelist_missing=1\n'
    return 0
  fi
  printf 'filelist_sha=%s\n' "$(sha256_one "$abs")"
  local list_base
  list_base="$(dirname "$abs")"
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    local line="${raw%%#*}"
    line="${line%%//*}"
    local -a toks=()
    read -r -a toks <<< "$line"
    local i=0
    while (( i < ${#toks[@]} )); do
      local tok="${toks[i]}"
      case "$tok" in
        -f|-F)
          printf 'arg=%s\n' "$tok"
          i=$((i + 1))
          if (( i < ${#toks[@]} )); then
            emit_filelist_fingerprint "${toks[i]}" "$list_base"
          fi
          ;;
        *)
          emit_verilator_input_fingerprint "$tok" "$list_base"
          ;;
      esac
      i=$((i + 1))
    done
  done < "$abs"
}

compute_artifact_cache_key() {
  local verilator_path verilator_version sibling_verilator_bin
  verilator_path="$(resolve_executable_path "$VERILATOR_BIN")"
  verilator_version="$("$VERILATOR_BIN" --version | tr '\n' '|')"
  sibling_verilator_bin="$(dirname "$verilator_path")/verilator_bin"
  {
    printf 'verilator_path=%s\n' "$verilator_path"
    if [[ -f "$verilator_path" ]]; then
      printf 'verilator_sha=%s\n' "$(sha256_one "$verilator_path")"
    fi
    if [[ -f "$sibling_verilator_bin" && "$sibling_verilator_bin" != "$verilator_path" ]]; then
      printf 'verilator_bin_path=%s\n' "$sibling_verilator_bin"
      printf 'verilator_bin_sha=%s\n' "$(sha256_one "$sibling_verilator_bin")"
    fi
    printf 'verilator_version=%s\n' "$verilator_version"
    printf 'top_module=%s\n' "$TOP_MODULE"
    printf 'sim_accel_assigns_per_kernel=%s\n' "$ASSIGNS_PER_KERNEL"
    printf 'invocation_cwd=%s\n' "$INVOCATION_CWD"
    local i=0
    while (( i < ${#SOURCES[@]} )); do
      local arg="${SOURCES[i]}"
      case "$arg" in
        -f|-F)
          printf 'arg=%s\n' "$arg"
          i=$((i + 1))
          if (( i < ${#SOURCES[@]} )); then
            emit_filelist_fingerprint "${SOURCES[i]}" "$INVOCATION_CWD"
          fi
          ;;
        *)
          emit_verilator_input_fingerprint "$arg" "$INVOCATION_CWD"
          ;;
      esac
      i=$((i + 1))
    done
  } | sha256sum | awk '{print $1}'
}

compute_generated_compile_bundle_sha() {
  {
    local path
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      printf 'file=%s\n' "$(basename "$path")"
      printf 'sha=%s\n' "$(sha256_one "$path")"
    done < <(find "$OUTDIR" -maxdepth 1 -type f \
      \( -name 'kernel_generated.cu' \
         -o -name 'kernel_generated.api.h' \
         -o -name 'kernel_generated.cpu.cpp' \
         -o -name 'kernel_generated.link.cu' \
         -o -name 'kernel_generated.clusters.tsv' \
         -o -name 'kernel_generated.part*.cu' \
         -o -name 'kernel_generated.cluster*.cu' \) | LC_ALL=C sort)
  } | sha256sum | awk '{print $1}'
}

compute_compile_cache_key() {
  local nvcc_version bench_sha bundle_sha
  nvcc_version="$(nvcc --version | tr '\n' '|')"
  bench_sha="$(sha256_one "$OUTDIR/bench_kernel.cu")"
  bundle_sha="$(compute_generated_compile_bundle_sha)"
  {
    printf 'nvcc_version=%s\n' "$nvcc_version"
    printf 'nvcc_flags=-O3 -std=c++17 -DSIM_ACCEL_PARTIAL_WRITE=1\n'
    printf 'bench_kernel_sha=%s\n' "$bench_sha"
    printf 'generated_bundle_sha=%s\n' "$bundle_sha"
    printf 'skip_cpu_reference_build=%s\n' "$SKIP_CPU_REFERENCE_BUILD"
    printf 'hybrid_mode=%s\n' "$HYBRID_MODE"
    printf 'hybrid_cluster_build_index=%s\n' "${HYBRID_BUILD_CLUSTER_INDEX:-}"
    printf 'hybrid_cluster_build_indices=%s\n' "${HYBRID_BUILD_CLUSTER_INDICES:-}"
    printf 'hybrid_cluster_build_owner_hint=%s\n' "${HYBRID_BUILD_CLUSTER_OWNER_HINT:-}"
    printf 'hybrid_cluster_build_fallback=%s\n' "${HYBRID_BUILD_CLUSTER_FALLBACK:-0}"
  } | sha256sum | awk '{print $1}'
}

OBJECT_CACHE_HITS=0
OBJECT_CACHE_MISSES=0

partition_object_namespace() {
  local src="$1"
  local base part_idx hierarchy_ns canonical_hash
  base="$(basename "$src")"
  if [[ "$base" =~ \.part([0-9]+)\.cu$ && -f "$KERNEL_PARTITIONS" ]]; then
    part_idx="${BASH_REMATCH[1]}"
    hierarchy_ns="$(awk -F '\t' -v idx="$part_idx" 'NR > 1 && $1 == idx { print $6; exit }' "$KERNEL_PARTITIONS")"
    canonical_hash="$(awk -F '\t' -v idx="$part_idx" 'NR > 1 && $1 == idx { print $9; exit }' "$KERNEL_PARTITIONS")"
    if [[ -n "$hierarchy_ns" || -n "$canonical_hash" ]]; then
      if [[ -z "$hierarchy_ns" ]]; then
        hierarchy_ns="shared"
      fi
      if [[ -z "$canonical_hash" ]]; then
        printf '%s\n' "$hierarchy_ns"
      else
        printf '%s/%s\n' "$hierarchy_ns" "$canonical_hash"
      fi
      return 0
    fi
  fi
  case "$base" in
    bench_kernel.cu) printf 'bench\n' ;;
    kernel_generated.cpu.cpp) printf 'cpu_ref\n' ;;
    kernel_generated.link.cu) printf 'link\n' ;;
    *) printf 'shared\n' ;;
  esac
}

append_partition_canonical_stats() {
  local partitions_tsv="$1"
  local out_log="$2"
  [[ -f "$partitions_tsv" ]] || return 0

  local stats
  stats="$(awk -F '\t' '
    NR == 1 { next }
    NF >= 9 {
      total += 1
      count[$9] += 1
    }
    END {
      unique = 0
      dup = 0
      max_count = 0
      for (k in count) {
        unique += 1
        if (count[k] > 1) dup += count[k] - 1
        if (count[k] > max_count) max_count = count[k]
      }
      printf "%d %d %d %d\n", total, unique, dup, max_count
    }' "$partitions_tsv")"
  local total unique dup max_count
  read -r total unique dup max_count <<<"$stats"
  {
    echo "partition_canonical_total=$total"
    echo "partition_canonical_unique=$unique"
    echo "partition_canonical_duplicates=$dup"
    echo "partition_canonical_max_reuse=$max_count"
  } >> "$out_log"
}

select_auto_hybrid_cluster_from_tsv() {
  local clusters_tsv="$1"
  local max_input_bits="$2"
  python3 - "$clusters_tsv" "$max_input_bits" <<'PY'
import csv
import sys

path = sys.argv[1]
max_bits = int(sys.argv[2])
preferred = None
fallback = None
preferred_count = 0
fallback_count = 0

def better(cur, best):
    if best is None:
        return True
    return ((cur["assign_count"], -cur["input_signature_bits"], -cur["index"])
            > (best["assign_count"], -best["input_signature_bits"], -best["index"]))

with open(path, newline="") as fh:
    reader = csv.DictReader(fh, delimiter="\t")
    for row in reader:
        idx = int(row["index"])
        assigns = int(row["assign_count"])
        bits = int(row["input_signature_bits"])
        owner = row["owner_hint"]
        if assigns <= 0 or bits > max_bits:
            continue
        cand = {"index": idx, "assign_count": assigns, "input_signature_bits": bits}
        if owner == "gpu_candidate":
            preferred_count += 1
            if better(cand, preferred):
                preferred = cand
        elif owner == "cpu_boundary_heavy":
            fallback_count += 1
            if better(cand, fallback):
                fallback = cand

if preferred is not None:
    print(f"{preferred['index']}\t{preferred_count + fallback_count}\t0\tgpu_candidate")
    sys.exit(0)
if fallback is not None:
    print(f"{fallback['index']}\t{preferred_count + fallback_count}\t1\tcpu_boundary_heavy")
    sys.exit(0)
sys.exit(1)
PY
}

select_auto_hybrid_cluster_group_from_tsv() {
  local clusters_tsv="$1"
  local group_size="$2"
  local max_input_bits="$3"
  python3 - "$clusters_tsv" "$group_size" "$max_input_bits" <<'PY'
import csv
import sys
from collections import Counter

path = sys.argv[1]
group_size = int(sys.argv[2])
max_bits = int(sys.argv[3])

WEIGHTS = {
    "and": 1.0,
    "or": 1.0,
    "xor": 1.0,
    "logand": 1.0,
    "logor": 1.0,
    "lognot": 1.0,
    "not": 1.0,
    "ccast": 1.0,
    "extend": 1.0,
    "extends": 1.0,
    "eq": 2.0,
    "neq": 2.0,
    "concat": 2.0,
    "cond": 2.5,
    "sel": 2.5,
    "add": 3.0,
    "sub": 3.0,
    "shiftl": 3.0,
    "shiftlovr": 3.0,
    "shiftr": 3.0,
    "shiftrovr": 3.0,
}

def parse_expr_kind_counts(raw):
    counts = Counter()
    if not raw or raw == "-":
      return counts
    for item in raw.split(";"):
      if not item:
        continue
      key, sep, value = item.partition("=")
      if not sep:
        continue
      counts[key] += int(value)
    return counts

def weighted_ops(counts):
    return sum(count * WEIGHTS.get(kind, 1.0)
               for kind, count in counts.items()
               if kind not in ("var", "const"))

def better(cur, best):
    if best is None:
        return True
    return ((cur["static_score"], cur["group_assign_count"], -cur["group_input_signature_bits"],
             -cur["cluster_indices"][0])
            > (best["static_score"], best["group_assign_count"], -best["group_input_signature_bits"],
               -best["cluster_indices"][0]))

rows = []
with open(path, newline="") as fh:
    reader = csv.DictReader(fh, delimiter="\t")
    for row in reader:
        assigns = int(row["assign_count"])
        if assigns <= 0:
            continue
        rows.append({
            "index": int(row["index"]),
            "topo_rank": int(row["topo_rank"]),
            "assign_count": assigns,
            "input_signature_bits": int(row["input_signature_bits"]),
            "owner_hint": row["owner_hint"],
            "expr_kind_counts": parse_expr_kind_counts(row.get("expr_kind_counts", "-")),
        })

rows_by_topo = sorted(rows, key=lambda r: (r["topo_rank"], r["index"]))
preferred = None
fallback = None
candidate_count = 0

for start in range(0, len(rows_by_topo) - group_size + 1):
    window = rows_by_topo[start:start + group_size]
    topo_ranks = [row["topo_rank"] for row in window]
    if any((b - a) != 1 for a, b in zip(topo_ranks, topo_ranks[1:])):
        continue
    group_input_bits = sum(row["input_signature_bits"] for row in window)
    if group_input_bits > max_bits:
        continue
    group_assign_count = sum(row["assign_count"] for row in window)
    group_expr_counts = sum((row["expr_kind_counts"] for row in window), Counter())
    group_weighted_ops = weighted_ops(group_expr_counts)
    static_score = group_weighted_ops - (8.0 * group_input_bits)
    owner_set = {row["owner_hint"] for row in window}
    owner_hint = next(iter(owner_set)) if len(owner_set) == 1 else "+".join(sorted(owner_set))
    candidate = {
        "cluster_indices": [row["index"] for row in window],
        "group_assign_count": group_assign_count,
        "group_input_signature_bits": group_input_bits,
        "group_weighted_ops": group_weighted_ops,
        "static_score": static_score,
        "owner_hint": owner_hint,
    }
    candidate_count += 1
    if any(owner == "gpu_candidate" for owner in owner_set):
        if better(candidate, preferred):
            preferred = candidate
    elif any(owner == "cpu_boundary_heavy" for owner in owner_set):
        if better(candidate, fallback):
            fallback = candidate

selected = preferred if preferred is not None else fallback
if selected is None:
    sys.exit(1)
fallback_used = 0 if preferred is not None else 1
print(
    f"{','.join(str(x) for x in selected['cluster_indices'])}\t"
    f"{candidate_count}\t{fallback_used}\t{selected['owner_hint']}\t"
    f"{selected['static_score']:.6f}\t{selected['group_weighted_ops']:.3f}\t"
    f"{selected['group_input_signature_bits']}\t{selected['group_assign_count']}"
)
PY
}

prepare_single_cluster_link_source() {
  local link_src="$1"
  local cluster_index="$2"
  python3 - "$link_src" "$cluster_index" <<'PY'
import sys

path = sys.argv[1]
cluster = int(sys.argv[2])
func_name = 'extern "C" __host__ cudaError_t sim_accel_eval_assignw_launch_cluster('

with open(path, "r", encoding="utf-8") as fh:
    text = fh.read()

start = text.find(func_name)
if start < 0:
    raise SystemExit(f"Could not find cluster launch function in {path}")
brace_start = text.find("{", start)
if brace_start < 0:
    raise SystemExit(f"Could not find function body start in {path}")

depth = 0
end = None
for idx in range(brace_start, len(text)):
    ch = text[idx]
    if ch == "{":
        depth += 1
    elif ch == "}":
        depth -= 1
        if depth == 0:
            end = idx + 1
            break
if end is None:
    raise SystemExit(f"Could not find function body end in {path}")

replacement = f'''extern "C" __host__ cudaError_t sim_accel_eval_assignw_launch_cluster(uint32_t index,\n                                                               const uint32_t* state_in,\n                                                               uint32_t* state_out,\n                                                               uint32_t nstates,\n                                                               uint32_t block_size) {{\n    const uint32_t block = block_size ? block_size : 256U;\n    const uint32_t grid = (nstates + block - 1U) / block;\n    switch (index) {{\n    case {cluster}U:\n        sim_accel_eval_assignw_u32_cluster{cluster}<<<grid, block>>>(state_in, state_out, nstates);\n        return cudaGetLastError();\n    default:\n        return cudaErrorInvalidValue;\n    }}\n}}'''

with open(path, "w", encoding="utf-8") as fh:
    fh.write(text[:start] + replacement + text[end:])
PY
}

prepare_cluster_group_link_source() {
  local link_src="$1"
  local cluster_indices_csv="$2"
  python3 - "$link_src" "$cluster_indices_csv" <<'PY'
import sys

path = sys.argv[1]
clusters = [int(x) for x in sys.argv[2].split(",") if x]
func_name = 'extern "C" __host__ cudaError_t sim_accel_eval_assignw_launch_cluster('

with open(path, "r", encoding="utf-8") as fh:
    text = fh.read()

start = text.find(func_name)
if start < 0:
    raise SystemExit(f"Could not find cluster launch function in {path}")
brace_start = text.find("{", start)
if brace_start < 0:
    raise SystemExit(f"Could not find function body start in {path}")

depth = 0
end = None
for idx in range(brace_start, len(text)):
    ch = text[idx]
    if ch == "{":
        depth += 1
    elif ch == "}":
        depth -= 1
        if depth == 0:
            end = idx + 1
            break
if end is None:
    raise SystemExit(f"Could not find function body end in {path}")

cases = "\n".join(
    f"    case {cluster}U:\n"
    f"        sim_accel_eval_assignw_u32_cluster{cluster}<<<grid, block>>>(state_in, state_out, nstates);\n"
    f"        return cudaGetLastError();"
    for cluster in clusters
)
replacement = f'''extern "C" __host__ cudaError_t sim_accel_eval_assignw_launch_cluster(uint32_t index,\n                                                               const uint32_t* state_in,\n                                                               uint32_t* state_out,\n                                                               uint32_t nstates,\n                                                               uint32_t block_size) {{\n    const uint32_t block = block_size ? block_size : 256U;\n    const uint32_t grid = (nstates + block - 1U) / block;\n    switch (index) {{\n{cases}\n    default:\n        return cudaErrorInvalidValue;\n    }}\n}}'''

with open(path, "w", encoding="utf-8") as fh:
    fh.write(text[:start] + replacement + text[end:])
PY
}

