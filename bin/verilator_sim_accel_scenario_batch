#!/usr/bin/env python3
"""Run multiple sim-accel benchmark scenarios and summarize total time."""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
import time
from collections import Counter
from typing import Any

REPO_ROOT = pathlib.Path(__file__).resolve().parents[2]
PROGRAM_HEX_TOOLS_DIR = REPO_ROOT / "scripts"
if PROGRAM_HEX_TOOLS_DIR.exists():
    sys.path.insert(0, str(PROGRAM_HEX_TOOLS_DIR))

try:
    from program_hex_tools import load_program_hex, patch_iterations, store_program_hex
except ImportError:
    load_program_hex = None
    patch_iterations = None
    store_program_hex = None

try:
    from scenario_manifest_tools import load_sim_accel_manifest
except ImportError:
    load_sim_accel_manifest = None


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="verilator_sim_accel_scenario_batch",
        description=(
            "Run multiple sim-accel benchmark scenarios against the same design "
            "and summarize total walltime."
        ),
    )
    parser.add_argument("--bench", default=None,
                        help="Path to verilator_sim_accel_bench (default: sibling helper)")
    parser.add_argument("--verilator", default="./bin/verilator",
                        help="Verilator binary (forwarded to bench)")
    parser.add_argument("--top-module", required=True, help="Top module name")
    parser.add_argument("--outdir", required=True, help="Batch output directory")
    parser.add_argument("--nstates", type=int, default=131072, help="Parallel state count")
    parser.add_argument("--state-chunk", type=int, default=0, help="States per launch chunk")
    parser.add_argument("--gpu-reps", type=int, default=200, help="GPU reps per scenario")
    parser.add_argument("--cpu-reps", type=int, default=20, help="CPU reps per scenario")
    parser.add_argument("--block-size", type=int, default=256, help="CUDA block size")
    parser.add_argument("--assigns-per-kernel", type=int, default=0,
                        help="Generated CUDA partition size limit")
    parser.add_argument("--compile-cache-dir",
                        default=os.environ.get("SIM_ACCEL_COMPILE_CACHE_DIR",
                                               "/tmp/verilator-sim-accel-compile-cache"),
                        help="Shared compile cache directory")
    parser.add_argument("--no-compile-cache", action="store_true",
                        help="Disable compile cache reuse")
    parser.add_argument("--skip-cpu-reference-build", action="store_true",
                        help="Forwarded to bench; keeps runtime focused on GPU path")
    parser.add_argument("--init-mode", default="random",
                        help="Default init mode for scenarios without override")
    parser.add_argument("--init-seed", type=int, default=1,
                        help="Default init seed for scenarios without override")
    parser.add_argument("--scenario-seeds", default="",
                        help="Comma-separated random seeds, e.g. 1,2,3")
    parser.add_argument("--scenario-init-files", default="",
                        help="Comma-separated init override files")
    parser.add_argument("--scenario-manifest",
                        help=("JSON file with scenarios: "
                              "[{name, init_mode, init_seed, init_file, "
                              "program_hex, program_hex_map, iterations}]"))
    parser.add_argument("--keep-going", action="store_true",
                        help="Continue after scenario failures")
    parser.add_argument("--keep-scenario-outdirs", action="store_true",
                        help="Do not delete scenario outdirs on failure")
    parser.add_argument("verilator_args", nargs=argparse.REMAINDER,
                        help="Arguments passed after -- to verilator_sim_accel_bench")
    args = parser.parse_args()
    if args.verilator_args and args.verilator_args[0] == "--":
        args.verilator_args = args.verilator_args[1:]
    if not args.verilator_args:
        parser.error("expected Verilator source arguments after --")
    if args.nstates <= 0 or args.gpu_reps <= 0 or args.cpu_reps <= 0 or args.block_size <= 0:
        parser.error("nstates, gpu-reps, cpu-reps, and block-size must be > 0")
    if args.assigns_per_kernel < 0 or args.state_chunk < 0:
        parser.error("assigns-per-kernel and state-chunk must be >= 0")
    return args


def default_bench_path() -> str:
    return str(pathlib.Path(__file__).with_name("verilator_sim_accel_bench"))


def sanitize_name(raw: str) -> str:
    cooked = re.sub(r"[^A-Za-z0-9_.-]+", "_", raw).strip("._")
    return cooked or "scenario"


def materialize_program_hex_variant(outdir: pathlib.Path, scenario: dict[str, Any]) -> pathlib.Path | None:
    program_hex = scenario.get("program_hex")
    if not program_hex:
        return None
    src = pathlib.Path(str(program_hex)).expanduser().resolve()
    if not src.exists():
        raise SystemExit(f"program_hex file not found: {src}")
    dst = outdir / "scenario_inputs" / sanitize_name(str(scenario["name"])) / "program.hex"
    dst.parent.mkdir(parents=True, exist_ok=True)
    iterations = scenario.get("iterations")
    if iterations is None:
        dst.write_bytes(src.read_bytes())
        return dst
    if load_program_hex is None or patch_iterations is None or store_program_hex is None:
        raise SystemExit("program_hex_tools.py is required to materialize iterations-based program_hex scenarios")
    patched = patch_iterations(load_program_hex(src), int(iterations))
    store_program_hex(dst, patched)
    return dst


def load_program_hex_map(path: pathlib.Path) -> list[tuple[int, int, str]]:
    entries: list[tuple[int, int, str]] = []
    for lineno, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue
        toks = line.split()
        if len(toks) == 2:
            addr_text, var_name = toks
            byte_count = 4
        elif len(toks) == 3:
            addr_text, byte_count_text, var_name = toks
            try:
                byte_count = int(byte_count_text, 0)
            except ValueError as exc:
                raise SystemExit(f"invalid byte count in program_hex_map {path}:{lineno}: {byte_count_text}") from exc
        else:
            raise SystemExit(
                f"invalid program_hex_map line in {path}:{lineno}: expected 'addr var' or 'addr bytes var'"
            )
        try:
            addr = int(addr_text, 0)
        except ValueError as exc:
            raise SystemExit(f"invalid address in program_hex_map {path}:{lineno}: {addr_text}") from exc
        if byte_count <= 0 or byte_count > 4:
            raise SystemExit(f"program_hex_map byte count must be in 1..4 at {path}:{lineno}")
        entries.append((addr, byte_count, var_name))
    if not entries:
        raise SystemExit(f"program_hex_map is empty: {path}")
    return entries


def materialize_program_hex_init_file(outdir: pathlib.Path, scenario: dict[str, Any]) -> pathlib.Path | None:
    program_hex_map = scenario.get("program_hex_map")
    if not program_hex_map:
        return None
    program_hex_path = scenario.get("program_hex_materialized") or scenario.get("program_hex")
    if not program_hex_path:
        raise SystemExit(
            f"scenario '{scenario['name']}' uses program_hex_map but has no program_hex/program_hex_materialized"
        )
    if load_program_hex is None:
        raise SystemExit("program_hex_tools.py is required to lower program_hex_map into init files")
    memory = load_program_hex(program_hex_path)
    map_entries = load_program_hex_map(pathlib.Path(str(program_hex_map)).expanduser().resolve())
    dst = outdir / "scenario_inputs" / sanitize_name(str(scenario["name"])) / "program_hex.init"
    dst.parent.mkdir(parents=True, exist_ok=True)
    lines: list[str] = []
    for addr, byte_count, var_name in map_entries:
        value = 0
        for byte_idx in range(byte_count):
            value |= (memory.get(addr + byte_idx, 0) & 0xFF) << (8 * byte_idx)
        lines.append(f"{var_name} 0x{value:08X}")
    dst.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return dst


def materialize_effective_init_file(outdir: pathlib.Path, scenario: dict[str, Any]) -> pathlib.Path | None:
    init_parts: list[pathlib.Path] = []
    if scenario.get("init_file"):
        init_parts.append(pathlib.Path(str(scenario["init_file"])).expanduser().resolve())
    generated = materialize_program_hex_init_file(outdir, scenario)
    if generated is not None:
        scenario["program_hex_init_file"] = str(generated)
        init_parts.append(generated)
    if not init_parts:
        return None
    if len(init_parts) == 1:
        return init_parts[0]
    dst = outdir / "scenario_inputs" / sanitize_name(str(scenario["name"])) / "effective.init"
    dst.parent.mkdir(parents=True, exist_ok=True)
    with dst.open("w", encoding="utf-8") as fh:
        for idx, part in enumerate(init_parts):
            text = part.read_text(encoding="utf-8")
            if idx:
                fh.write("\n")
            fh.write(text)
            if not text.endswith("\n"):
                fh.write("\n")
    return dst


def build_scenarios(args: argparse.Namespace) -> list[dict[str, Any]]:
    scenarios: list[dict[str, Any]] = []
    if args.scenario_seeds:
        for seed_text in [x.strip() for x in args.scenario_seeds.split(",") if x.strip()]:
            seed = int(seed_text, 0)
            scenarios.append({
                "name": f"seed{seed:06d}",
                "init_mode": args.init_mode,
                "init_seed": seed,
                "init_file": None,
                "program_hex": None,
                "program_hex_map": None,
                "iterations": None,
            })
    if args.scenario_init_files:
        for path_text in [x.strip() for x in args.scenario_init_files.split(",") if x.strip()]:
            path = pathlib.Path(path_text).expanduser().resolve()
            scenarios.append({
                "name": sanitize_name(path.stem),
                "init_mode": args.init_mode,
                "init_seed": args.init_seed,
                "init_file": str(path),
                "program_hex": None,
                "program_hex_map": None,
                "iterations": None,
            })
    if args.scenario_manifest:
        if load_sim_accel_manifest is None:
            raise SystemExit("scenario_manifest_tools.py is required to use --scenario-manifest")
        for item in load_sim_accel_manifest(args.scenario_manifest, args.init_mode, args.init_seed):
            scenarios.append(item)
    if not scenarios:
        raise SystemExit("No scenarios specified. Use --scenario-seeds, --scenario-init-files, or --scenario-manifest.")
    # Preserve order but ensure stable unique names.
    name_counts: Counter[str] = Counter()
    for scenario in scenarios:
        base = sanitize_name(str(scenario["name"]))
        name_counts[base] += 1
        scenario["name"] = base if name_counts[base] == 1 else f"{base}_{name_counts[base]:02d}"
        if scenario.get("program_hex") and not scenario.get("init_file") and not scenario.get("program_hex_map"):
            sys.stderr.write(
                f"warning: scenario '{scenario['name']}' carries program_hex/iterations metadata, "
                "but the current sim-accel path does not lower that into runtime state yet; "
                "provide init_file or program_hex_map if you need the scenario to affect execution.\n"
            )
    return scenarios


def parse_metrics(text: str) -> dict[str, str]:
    metrics: dict[str, str] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if re.fullmatch(r"[A-Za-z0-9_]+", key):
            metrics[key] = value
    return metrics


def to_number(value: str | None) -> float | int | None:
    if value is None:
        return None
    if value in {"skipped", ""}:
        return None
    if re.fullmatch(r"-?[0-9]+", value):
        try:
            return int(value)
        except ValueError:
            return None
    if re.fullmatch(r"-?[0-9]+(?:\.[0-9]+)?", value):
        try:
            return float(value)
        except ValueError:
            return None
    return None


def write_tsv(path: pathlib.Path, rows: list[dict[str, Any]]) -> None:
    headers = [
        "name",
        "returncode",
        "walltime_s",
        "init_mode",
        "init_seed",
        "init_file",
        "program_hex",
        "program_hex_map",
        "program_hex_materialized",
        "program_hex_init_file",
        "effective_init_file",
        "iterations",
        "cpu_reference_checked",
        "mismatch",
        "compact_mismatch",
        "gpu_ms_per_rep",
        "cpu_ms_per_rep",
        "speedup_gpu_over_cpu",
        "verilator_codegen_s",
        "nvcc_compile_s",
        "bench_run_s",
        "total_elapsed_s",
        "verilator_artifact_cache_mode",
        "nvcc_cache_mode",
        "cuda_assignw_offload_pct",
    ]
    with path.open("w", encoding="utf-8") as fh:
        fh.write("\t".join(headers) + "\n")
        for row in rows:
            values = [str(row.get(h, "")) for h in headers]
            fh.write("\t".join(values) + "\n")


def main() -> int:
    args = parse_args()
    bench = pathlib.Path(args.bench or default_bench_path()).resolve()
    if not bench.exists():
        raise SystemExit(f"Missing bench helper: {bench}")
    scenarios = build_scenarios(args)
    outdir = pathlib.Path(args.outdir).expanduser().resolve()
    outdir.mkdir(parents=True, exist_ok=True)
    scenario_root = outdir / "scenarios"
    scenario_root.mkdir(exist_ok=True)
    compile_cache_dir = pathlib.Path(args.compile_cache_dir).expanduser().resolve()
    compile_cache_dir.mkdir(parents=True, exist_ok=True)

    aggregate_walltime = 0.0
    aggregate_total_elapsed = 0.0
    aggregate_bench_run = 0.0
    success_count = 0
    failure_count = 0
    nvcc_modes: Counter[str] = Counter()
    artifact_modes: Counter[str] = Counter()
    rows: list[dict[str, Any]] = []
    scenario_records: list[dict[str, Any]] = []

    for index, scenario in enumerate(scenarios, start=1):
        scenario_outdir = scenario_root / scenario["name"]
        scenario_outdir.mkdir(parents=True, exist_ok=True)
        materialized_program_hex = materialize_program_hex_variant(outdir, scenario)
        if materialized_program_hex is not None:
            scenario["program_hex_materialized"] = str(materialized_program_hex)
        effective_init_file = materialize_effective_init_file(outdir, scenario)
        if effective_init_file is not None:
            scenario["effective_init_file"] = str(effective_init_file)
        cmd = [
            str(bench),
            "--verilator", args.verilator,
            "--top-module", args.top_module,
            "--outdir", str(scenario_outdir),
            "--nstates", str(args.nstates),
            "--state-chunk", str(args.state_chunk),
            "--gpu-reps", str(args.gpu_reps),
            "--cpu-reps", str(args.cpu_reps),
            "--block-size", str(args.block_size),
            "--init-mode", str(scenario["init_mode"]),
            "--init-seed", str(scenario["init_seed"]),
            "--assigns-per-kernel", str(args.assigns_per_kernel),
            "--compile-cache-dir", str(compile_cache_dir),
        ]
        if args.no_compile_cache:
            cmd.append("--no-compile-cache")
        if args.skip_cpu_reference_build:
            cmd.append("--skip-cpu-reference-build")
        if scenario.get("effective_init_file"):
            cmd.extend(["--init-file", str(scenario["effective_init_file"])])
        cmd.append("--")
        cmd.extend(args.verilator_args)

        print(f"[{index}/{len(scenarios)}] {scenario['name']}")
        start = time.monotonic()
        proc = subprocess.run(cmd, text=True, capture_output=True)
        walltime = time.monotonic() - start
        aggregate_walltime += walltime

        (scenario_outdir / "driver_stdout.log").write_text(proc.stdout, encoding="utf-8")
        (scenario_outdir / "driver_stderr.log").write_text(proc.stderr, encoding="utf-8")

        metrics = parse_metrics(proc.stdout)
        total_elapsed = to_number(metrics.get("total_elapsed_s"))
        bench_run_s = to_number(metrics.get("bench_run_s"))
        if isinstance(total_elapsed, (int, float)):
            aggregate_total_elapsed += float(total_elapsed)
        if isinstance(bench_run_s, (int, float)):
            aggregate_bench_run += float(bench_run_s)
        nvcc_modes[metrics.get("nvcc_cache_mode", "unknown")] += 1
        artifact_modes[metrics.get("verilator_artifact_cache_mode", "unknown")] += 1

        row = {
            "name": scenario["name"],
            "returncode": proc.returncode,
            "walltime_s": f"{walltime:.6f}",
            "init_mode": scenario["init_mode"],
            "init_seed": scenario["init_seed"],
            "init_file": scenario.get("init_file") or "",
            "program_hex": scenario.get("program_hex") or "",
            "program_hex_map": scenario.get("program_hex_map") or "",
            "program_hex_materialized": scenario.get("program_hex_materialized") or "",
            "program_hex_init_file": scenario.get("program_hex_init_file") or "",
            "effective_init_file": scenario.get("effective_init_file") or "",
            "iterations": scenario.get("iterations") if scenario.get("iterations") is not None else "",
            "cpu_reference_checked": metrics.get("cpu_reference_checked", ""),
            "mismatch": metrics.get("mismatch", ""),
            "compact_mismatch": metrics.get("compact_mismatch", ""),
            "gpu_ms_per_rep": metrics.get("gpu_ms_per_rep", ""),
            "cpu_ms_per_rep": metrics.get("cpu_ms_per_rep", ""),
            "speedup_gpu_over_cpu": metrics.get("speedup_gpu_over_cpu", ""),
            "verilator_codegen_s": metrics.get("verilator_codegen_s", ""),
            "nvcc_compile_s": metrics.get("nvcc_compile_s", ""),
            "bench_run_s": metrics.get("bench_run_s", ""),
            "total_elapsed_s": metrics.get("total_elapsed_s", ""),
            "verilator_artifact_cache_mode": metrics.get("verilator_artifact_cache_mode", ""),
            "nvcc_cache_mode": metrics.get("nvcc_cache_mode", ""),
            "cuda_assignw_offload_pct": metrics.get("cuda_assignw_offload_pct", ""),
        }
        rows.append(row)
        scenario_records.append({
            "name": scenario["name"],
            "init_mode": scenario["init_mode"],
            "init_seed": scenario["init_seed"],
            "init_file": scenario.get("init_file"),
            "program_hex": scenario.get("program_hex"),
            "program_hex_map": scenario.get("program_hex_map"),
            "program_hex_materialized": scenario.get("program_hex_materialized"),
            "program_hex_init_file": scenario.get("program_hex_init_file"),
            "effective_init_file": scenario.get("effective_init_file"),
            "iterations": scenario.get("iterations"),
            "outdir": str(scenario_outdir),
            "returncode": proc.returncode,
            "walltime_s": walltime,
            "metrics": metrics,
        })

        if proc.returncode == 0:
            success_count += 1
        else:
            failure_count += 1
            sys.stderr.write(proc.stderr)
            sys.stderr.write(proc.stdout)
            if not args.keep_going:
                if not args.keep_scenario_outdirs:
                    pass
                break

    summary_tsv = outdir / "scenario_batch.tsv"
    summary_json = outdir / "scenario_batch.json"
    write_tsv(summary_tsv, rows)
    summary = {
        "schema_version": "sim-accel-scenario-batch-v1",
        "bench": str(bench),
        "top_module": args.top_module,
        "compile_cache_dir": str(compile_cache_dir),
        "aggregate": {
            "scenario_count": len(rows),
            "success_count": success_count,
            "failure_count": failure_count,
            "walltime_s": round(aggregate_walltime, 6),
            "reported_total_elapsed_s": round(aggregate_total_elapsed, 6),
            "reported_bench_run_s": round(aggregate_bench_run, 6),
            "nvcc_cache_mode_counts": dict(nvcc_modes),
            "verilator_artifact_cache_mode_counts": dict(artifact_modes),
        },
        "scenarios": scenario_records,
    }
    summary_json.write_text(json.dumps(summary, indent=2, sort_keys=True), encoding="utf-8")

    print("== scenario batch summary ==")
    print(f"outdir={outdir}")
    print(f"scenario_count={len(rows)}")
    print(f"success_count={success_count}")
    print(f"failure_count={failure_count}")
    print(f"scenario_batch_walltime_s={aggregate_walltime:.6f}")
    print(f"scenario_batch_reported_total_elapsed_s={aggregate_total_elapsed:.6f}")
    print(f"scenario_batch_reported_bench_run_s={aggregate_bench_run:.6f}")
    print(f"scenario_batch_summary_tsv={summary_tsv}")
    print(f"scenario_batch_summary_json={summary_json}")

    return 0 if failure_count == 0 else 1


if __name__ == "__main__":
    raise SystemExit(main())
