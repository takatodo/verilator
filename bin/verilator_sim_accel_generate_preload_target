from __future__ import annotations

import argparse
import csv
import json
import pathlib
import re

FULL_MEMORY_ARRAY_KIND = "memory-array-preload-v1"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate a sim-accel preload target descriptor from generated metadata"
    )
    parser.add_argument("--vars-tsv")
    parser.add_argument("--preload-targets-tsv")
    parser.add_argument("--preload-target-elements-tsv")
    parser.add_argument("--name")
    parser.add_argument("--target-path")
    parser.add_argument(
        "--var-regex",
        help="Regex applied to vars.tsv 'name'; first capture group is the element index",
    )
    parser.add_argument("--word-bits", type=int)
    parser.add_argument("--base-addr", type=int, default=0)
    parser.add_argument("--address-unit-bytes", type=int)
    parser.add_argument("--index-base", type=int, default=0)
    parser.add_argument("--depth", type=int, default=0)
    parser.add_argument("--description", default="")
    parser.add_argument("--default-format", default="auto")
    parser.add_argument("--endianness", default="little")
    parser.add_argument("--out", required=True)
    args = parser.parse_args()
    if bool(args.vars_tsv) == bool(args.preload_targets_tsv):
        parser.error("exactly one of --vars-tsv or --preload-targets-tsv is required")
    if args.vars_tsv:
        missing = []
        if not args.name:
            missing.append("--name")
        if not args.target_path:
            missing.append("--target-path")
        if not args.var_regex:
            missing.append("--var-regex")
        if args.word_bits is None:
            missing.append("--word-bits")
        if missing:
            parser.error("vars-tsv mode requires " + ", ".join(missing))
    else:
        if not args.name and not args.target_path:
            parser.error("preload-targets-tsv mode requires --name or --target-path")
    return args


def main() -> int:
    args = parse_args()
    out = pathlib.Path(args.out).expanduser().resolve()

    if args.preload_targets_tsv:
        targets_tsv = pathlib.Path(args.preload_targets_tsv).expanduser().resolve()
        elements_by_target: dict[str, list[dict[str, int | str]]] = {}
        if args.preload_target_elements_tsv:
            elements_tsv = pathlib.Path(args.preload_target_elements_tsv).expanduser().resolve()
            with elements_tsv.open(encoding="utf-8", newline="") as fh:
                reader = csv.DictReader(fh, delimiter="\t")
                fieldnames = set(reader.fieldnames or [])
                required = {"target_path", "index", "offset", "byte_count", "var_name"}
                missing = sorted(required - fieldnames)
                if missing:
                    raise SystemExit(
                        "preload_target_elements.tsv is missing columns "
                        + ",".join(missing)
                        + f": {elements_tsv}"
                    )
                for row in reader:
                    elements_by_target.setdefault(row["target_path"], []).append(
                        {
                            "index": int(row["index"], 0),
                            "offset": int(row["offset"], 0),
                            "byte_count": int(row["byte_count"], 0),
                            "var_name": row["var_name"],
                        }
                    )
        with targets_tsv.open(encoding="utf-8", newline="") as fh:
            reader = csv.DictReader(fh, delimiter="\t")
            fieldnames = set(reader.fieldnames or [])
            required = {
                "kind",
                "name",
                "target_path",
                "word_bits",
                "depth",
                "base_addr",
                "address_unit_bytes",
                "endianness",
            }
            missing = sorted(required - fieldnames)
            if missing:
                raise SystemExit(
                    f"preload_targets.tsv is missing columns {','.join(missing)}: {targets_tsv}"
                )
            matched_row = None
            for row in reader:
                if args.target_path and row["target_path"] != args.target_path:
                    continue
                if args.name and row["name"] != args.name:
                    continue
                matched_row = row
                break
        if matched_row is None:
            selector = args.target_path or args.name
            raise SystemExit(f"no preload target matched '{selector}' in {targets_tsv}")
        payload = {
            "kind": matched_row["kind"],
            "name": matched_row["name"],
            "description": args.description,
            "target_path": matched_row["target_path"],
            "word_bits": int(matched_row["word_bits"], 0),
            "depth": int(matched_row["depth"], 0),
            "base_addr": int(matched_row["base_addr"], 0),
            "address_unit_bytes": int(matched_row["address_unit_bytes"], 0),
            "endianness": matched_row["endianness"],
            "default_format": args.default_format,
            "elements": sorted(
                elements_by_target.get(matched_row["target_path"], []),
                key=lambda item: (int(item["index"]), int(item["offset"]), str(item["var_name"])),
            ),
        }
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return 0

    vars_tsv = pathlib.Path(args.vars_tsv).expanduser().resolve()
    pattern = re.compile(args.var_regex)
    word_bytes = args.address_unit_bytes or max(1, (args.word_bits + 7) // 8)

    elements: list[dict[str, int | str]] = []
    with vars_tsv.open(encoding="utf-8", newline="") as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        if "name" not in (reader.fieldnames or []):
            raise SystemExit(f"vars.tsv is missing 'name' column: {vars_tsv}")
        for row in reader:
            var_name = row["name"]
            match = pattern.search(var_name)
            if not match:
                continue
            index = int(match.group(1))
            if index < args.index_base:
                continue
            offset = (index - args.index_base) * word_bytes
            elements.append(
                {
                    "index": index,
                    "offset": offset,
                    "byte_count": word_bytes,
                    "var_name": var_name,
                }
            )

    if not elements:
        raise SystemExit(f"no vars matched regex in {vars_tsv}")

    elements.sort(key=lambda item: int(item["index"]))
    depth = args.depth or (int(elements[-1]["index"]) - args.index_base + 1)

    payload = {
        "kind": FULL_MEMORY_ARRAY_KIND,
        "name": args.name,
        "description": args.description,
        "target_path": args.target_path,
        "word_bits": args.word_bits,
        "depth": depth,
        "base_addr": args.base_addr,
        "address_unit_bytes": word_bytes,
        "endianness": args.endianness,
        "default_format": args.default_format,
        "elements": elements,
    }
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
