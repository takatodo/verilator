from __future__ import annotations

import argparse
import csv
import json
import pathlib
import re

FULL_MEMORY_ARRAY_KIND = "memory-array-preload-v1"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate a memory-array preload target descriptor from sim-accel vars.tsv"
    )
    parser.add_argument("--vars-tsv", required=True)
    parser.add_argument("--name", required=True)
    parser.add_argument("--target-path", required=True)
    parser.add_argument(
        "--var-regex",
        required=True,
        help="Regex applied to vars.tsv 'name'; first capture group is the element index",
    )
    parser.add_argument("--word-bits", type=int, required=True)
    parser.add_argument("--base-addr", type=int, default=0)
    parser.add_argument("--address-unit-bytes", type=int)
    parser.add_argument("--index-base", type=int, default=0)
    parser.add_argument("--depth", type=int, default=0)
    parser.add_argument("--description", default="")
    parser.add_argument("--default-format", default="auto")
    parser.add_argument("--endianness", default="little")
    parser.add_argument("--out", required=True)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    vars_tsv = pathlib.Path(args.vars_tsv).expanduser().resolve()
    out = pathlib.Path(args.out).expanduser().resolve()
    pattern = re.compile(args.var_regex)
    word_bytes = args.address_unit_bytes or max(1, (args.word_bits + 7) // 8)

    elements: list[dict[str, int | str]] = []
    with vars_tsv.open(encoding="utf-8", newline="") as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        if "name" not in (reader.fieldnames or []):
            raise SystemExit(f"vars.tsv is missing 'name' column: {vars_tsv}")
        for row in reader:
            var_name = row["name"]
            match = pattern.search(var_name)
            if not match:
                continue
            index = int(match.group(1))
            if index < args.index_base:
                continue
            offset = (index - args.index_base) * word_bytes
            elements.append(
                {
                    "index": index,
                    "offset": offset,
                    "byte_count": word_bytes,
                    "var_name": var_name,
                }
            )

    if not elements:
        raise SystemExit(f"no vars matched regex in {vars_tsv}")

    elements.sort(key=lambda item: int(item["index"]))
    depth = args.depth or (int(elements[-1]["index"]) - args.index_base + 1)

    payload = {
        "kind": FULL_MEMORY_ARRAY_KIND,
        "name": args.name,
        "description": args.description,
        "target_path": args.target_path,
        "word_bits": args.word_bits,
        "depth": depth,
        "base_addr": args.base_addr,
        "address_unit_bytes": word_bytes,
        "endianness": args.endianness,
        "default_format": args.default_format,
        "elements": elements,
    }
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
