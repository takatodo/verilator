#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"

usage() {
  cat <<EOF2
Usage:
  ${SCRIPT_NAME} --top-module TOP --outdir DIR [options] -- <rtl files...>

Options:
  --verilator PATH     Verilator binary (default: ./bin/verilator)
  --top-module TOP     Top module name
  --outdir DIR         Output directory
  --nstates N          Number of parallel states for each cluster bench (default: 1024)
  --gpu-reps N         GPU repetitions for timing (default: 1)
  --cpu-reps N         CPU repetitions for timing (default: 1)
  --block-size N       CUDA block size (default: 256)
  --init-mode MODE     Initial state mode: random|zero|ones|counter (default: random)
  --init-seed N        Seed for random init mode (default: 1)
  --assigns-per-kernel N
                        Limit emitted assigns per generated CUDA kernel partition (default: 0)
  --compile-cache-dir DIR
                        Reuse compiled bench binaries across runs
                        (default: /tmp/verilator-sim-accel-compile-cache)
  --cluster-limit N    Maximum clusters to benchmark (default: 10)
  --cluster-group-size N
                        Benchmark group size: 1..8 (default: 1)
  --cluster-max-input-bits N
                        Filter clusters by input-signature bits (default: 128)
  --cluster-min-assigns N
                        Filter clusters by minimum assign count (default: 1)
  --cluster-owner LIST Comma-separated owner hints to include
                        (default: gpu_candidate,cpu_boundary_heavy)
  --cluster-indices LIST
                        Explicit comma-separated cluster indices to benchmark
  --worthy-min-speedup X
                        Minimum cpu/gpu speedup ratio to mark a cluster as offload-worthy
                        (default: 1.05)
  --worthy-min-margin-ms X
                        Minimum cpu_ms - gpu_ms margin to mark a cluster as offload-worthy
                        (default: 0.50)
  --keep-cluster-outdirs
                        Keep per-cluster output directories (default: off)

Example:
  ${SCRIPT_NAME} \
    --verilator ./bin/verilator \
    --top-module tb_top \
    --outdir /tmp/veer_sweep \
    --nstates 1024 \
    --gpu-reps 1 \
    --cpu-reps 1 \
    --cluster-limit 8 \
    --cluster-max-input-bits 128 \
    -- --timing +incdir+verilogIncludeFiles +define+__RTLMETER_MAIN_CLOCK=tb_top.core_clk -f filelist
EOF2
}

VERILATOR_BIN="./bin/verilator"
TOP_MODULE=""
OUTDIR=""
NSTATES=1024
GPU_REPS=1
CPU_REPS=1
BLOCK_SIZE=256
INIT_MODE="random"
INIT_SEED=1
ASSIGNS_PER_KERNEL=0
COMPILE_CACHE_DIR="${SIM_ACCEL_COMPILE_CACHE_DIR:-/tmp/verilator-sim-accel-compile-cache}"
CLUSTER_LIMIT=10
CLUSTER_GROUP_SIZE=1
CLUSTER_MAX_INPUT_BITS=128
CLUSTER_MIN_ASSIGNS=1
CLUSTER_OWNER_LIST="gpu_candidate,cpu_boundary_heavy"
CLUSTER_INDICES=""
WORTHY_MIN_SPEEDUP="1.05"
WORTHY_MIN_MARGIN_MS="0.50"
KEEP_CLUSTER_OUTDIRS=0
declare -a SOURCES=()
INVOCATION_CWD="$(pwd)"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verilator)
      VERILATOR_BIN="$2"; shift 2 ;;
    --top-module)
      TOP_MODULE="$2"; shift 2 ;;
    --outdir)
      OUTDIR="$2"; shift 2 ;;
    --nstates)
      NSTATES="$2"; shift 2 ;;
    --gpu-reps)
      GPU_REPS="$2"; shift 2 ;;
    --cpu-reps)
      CPU_REPS="$2"; shift 2 ;;
    --block-size)
      BLOCK_SIZE="$2"; shift 2 ;;
    --init-mode)
      INIT_MODE="$2"; shift 2 ;;
    --init-seed)
      INIT_SEED="$2"; shift 2 ;;
    --assigns-per-kernel)
      ASSIGNS_PER_KERNEL="$2"; shift 2 ;;
    --compile-cache-dir)
      COMPILE_CACHE_DIR="$2"; shift 2 ;;
    --cluster-limit)
      CLUSTER_LIMIT="$2"; shift 2 ;;
    --cluster-group-size)
      CLUSTER_GROUP_SIZE="$2"; shift 2 ;;
    --cluster-max-input-bits)
      CLUSTER_MAX_INPUT_BITS="$2"; shift 2 ;;
    --cluster-min-assigns)
      CLUSTER_MIN_ASSIGNS="$2"; shift 2 ;;
    --cluster-owner)
      CLUSTER_OWNER_LIST="$2"; shift 2 ;;
    --cluster-indices)
      CLUSTER_INDICES="$2"; shift 2 ;;
    --worthy-min-speedup)
      WORTHY_MIN_SPEEDUP="$2"; shift 2 ;;
    --worthy-min-margin-ms)
      WORTHY_MIN_MARGIN_MS="$2"; shift 2 ;;
    --keep-cluster-outdirs)
      KEEP_CLUSTER_OUTDIRS=1; shift ;;
    --help|-h)
      usage; exit 0 ;;
    --)
      shift
      SOURCES=("$@")
      break ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2 ;;
  esac
done

if [[ -z "$TOP_MODULE" || -z "$OUTDIR" || ${#SOURCES[@]} -eq 0 ]]; then
  usage >&2
  exit 2
fi

for v in NSTATES GPU_REPS CPU_REPS BLOCK_SIZE ASSIGNS_PER_KERNEL CLUSTER_LIMIT CLUSTER_GROUP_SIZE CLUSTER_MAX_INPUT_BITS CLUSTER_MIN_ASSIGNS INIT_SEED; do
  if ! [[ "${!v}" =~ ^[0-9]+$ ]]; then
    echo "Invalid numeric value for $v: ${!v}" >&2
    exit 2
  fi
done
for v in WORTHY_MIN_SPEEDUP WORTHY_MIN_MARGIN_MS; do
  if ! [[ "${!v}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "Invalid numeric value for $v: ${!v}" >&2
    exit 2
  fi
done
if [[ "$NSTATES" -eq 0 || "$BLOCK_SIZE" -eq 0 || "$CLUSTER_LIMIT" -eq 0 ]]; then
  echo "NSTATES, BLOCK_SIZE, and CLUSTER_LIMIT must be > 0" >&2
  exit 2
fi
if [[ "$CLUSTER_GROUP_SIZE" -lt 1 || "$CLUSTER_GROUP_SIZE" -gt 8 ]]; then
  echo "CLUSTER_GROUP_SIZE must be in 1..8" >&2
  exit 2
fi

mkdir -p "$OUTDIR"
OUTDIR="$(cd "$OUTDIR" && pwd)"
COMPILE_CACHE_DIR="$(mkdir -p "$COMPILE_CACHE_DIR" && cd "$COMPILE_CACHE_DIR" && pwd)"
ANALYSIS_OUT="$OUTDIR/analysis"
mkdir -p "$ANALYSIS_OUT"
ANALYSIS_KERNEL="$ANALYSIS_OUT/${TOP_MODULE}.sim_accel.kernel.cu"
ANALYSIS_CLUSTERS="$ANALYSIS_KERNEL.clusters.tsv"
SUMMARY_TSV="$OUTDIR/cluster_sweep.tsv"
SUMMARY_JSON="$OUTDIR/cluster_sweep.json"

VERILATOR_SIM_ACCEL_ARGS=()
if [[ "$ASSIGNS_PER_KERNEL" -gt 0 ]]; then
  VERILATOR_SIM_ACCEL_ARGS+=(--sim-accel-assigns-per-kernel "$ASSIGNS_PER_KERNEL")
fi

if [[ ! -f "$ANALYSIS_CLUSTERS" ]]; then
  echo "[1/3] Generating cluster metadata..."
  env CCACHE_DISABLE=1 "$VERILATOR_BIN" \
    --Wno-fatal --no-skip-identical \
    --top-module "$TOP_MODULE" \
    --sim-accel-only \
    --sim-accel-output "$ANALYSIS_KERNEL" \
    "${VERILATOR_SIM_ACCEL_ARGS[@]}" \
    "${SOURCES[@]}" \
    >"$ANALYSIS_OUT/verilator_cuda.log" 2>&1
fi

if [[ ! -f "$ANALYSIS_CLUSTERS" ]]; then
  echo "Missing cluster metadata: $ANALYSIS_CLUSTERS" >&2
  exit 1
fi

echo "[2/3] Selecting clusters..."
python3 - "$ANALYSIS_CLUSTERS" "$CLUSTER_LIMIT" "$CLUSTER_GROUP_SIZE" "$CLUSTER_MAX_INPUT_BITS" "$CLUSTER_MIN_ASSIGNS" \
  "$CLUSTER_OWNER_LIST" "$CLUSTER_INDICES" "$SUMMARY_JSON" <<'PY'
import csv, json, sys
from collections import Counter
path, limit_s, group_size_s, max_bits_s, min_assigns_s, owner_list, indices_s, out_json = sys.argv[1:9]
limit = int(limit_s)
group_size = int(group_size_s)
max_bits = int(max_bits_s)
min_assigns = int(min_assigns_s)
owners = {x for x in owner_list.split(',') if x}
explicit = None
if indices_s:
    explicit = {int(x) for x in indices_s.split(',') if x}

def parse_expr_kind_counts(raw):
    counts = Counter()
    if not raw or raw == '-':
        return counts
    for item in raw.split(';'):
        if not item:
            continue
        key, sep, value = item.partition('=')
        if not sep:
            continue
        counts[key] += int(value)
    return counts

def format_expr_kind_counts(counts):
    if not counts:
        return '-'
    return ';'.join(f"{key}={counts[key]}" for key in sorted(counts))

rows = []
with open(path, newline='') as fh:
    for row in csv.DictReader(fh, delimiter='\t'):
        idx = int(row['index'])
        assigns = int(row['assign_count'])
        operator_count = int(row.get('operator_count', '0'))
        bits = int(row['input_signature_bits'])
        owner = row['owner_hint']
        if explicit is not None and idx not in explicit:
            continue
        if owner not in owners:
            continue
        if assigns < min_assigns or bits > max_bits:
            continue
        rows.append({
            'index': idx,
            'topo_rank': int(row['topo_rank']),
            'assign_count': assigns,
            'operator_count': operator_count,
            'input_signature_bits': bits,
            'owner_hint': owner,
            'dominant_hierarchy': row.get('dominant_hierarchy', ''),
            'expr_kind_counts': parse_expr_kind_counts(row.get('expr_kind_counts', '-')),
        })
rows.sort(key=lambda r: (-r['assign_count'], r['input_signature_bits'], r['index']))
if group_size == 1:
    selected = [{
        'cluster_indices': [row['index']],
        'cluster_group_size': 1,
        'group_assign_count': row['assign_count'],
        'group_operator_count': row['operator_count'],
        'group_input_signature_bits': row['input_signature_bits'],
        'owner_hint': row['owner_hint'],
        'topo_rank': row['topo_rank'],
        'topo_span': 0,
        'dominant_hierarchy': row['dominant_hierarchy'],
        'group_expr_kind_counts': format_expr_kind_counts(row['expr_kind_counts']),
    } for row in rows[:limit]]
    candidate_count = len(rows)
else:
    rows_by_topo = sorted(rows, key=lambda r: (r['topo_rank'], r['index']))
    groups = []
    for start in range(0, len(rows_by_topo) - group_size + 1):
        window = rows_by_topo[start:start + group_size]
        topo_ranks = [row['topo_rank'] for row in window]
        if any((b - a) != 1 for a, b in zip(topo_ranks, topo_ranks[1:])):
            continue
        owner_hints = {row['owner_hint'] for row in window}
        dominant_hierarchies = {row['dominant_hierarchy'] for row in window}
        groups.append({
            'cluster_indices': [row['index'] for row in window],
            'cluster_group_size': group_size,
            'group_assign_count': sum(row['assign_count'] for row in window),
            'group_operator_count': sum(row['operator_count'] for row in window),
            'group_input_signature_bits': sum(row['input_signature_bits'] for row in window),
            'owner_hint': next(iter(owner_hints)) if len(owner_hints) == 1 else '+'.join(sorted(owner_hints)),
            'topo_rank': topo_ranks[0],
            'topo_span': topo_ranks[-1] - topo_ranks[0],
            'dominant_hierarchy': next(iter(dominant_hierarchies)) if len(dominant_hierarchies) == 1 else 'mixed',
            'group_expr_kind_counts': format_expr_kind_counts(
                sum((row['expr_kind_counts'] for row in window), Counter())),
        })
    groups.sort(key=lambda r: (-r['group_assign_count'], r['group_input_signature_bits'], r['topo_span'], r['cluster_indices']))
    selected = groups[:limit]
    candidate_count = len(groups)
with open(out_json, 'w', encoding='utf-8') as fh:
    json.dump({'selected_clusters': selected, 'candidate_count': candidate_count}, fh, indent=2)
for row in selected:
    print(f"{','.join(str(x) for x in row['cluster_indices'])}\t{row['cluster_group_size']}\t{row['group_assign_count']}\t{row['group_operator_count']}\t{row['group_input_signature_bits']}\t{row['owner_hint']}\t{row['topo_rank']}\t{row['topo_span']}\t{row['dominant_hierarchy']}\t{row['group_expr_kind_counts']}")
PY

mapfile -t SELECTED_LINES < <(python3 - <<'PY' "$SUMMARY_JSON"
import json, sys
j=json.load(open(sys.argv[1]))
for row in j['selected_clusters']:
    print(f"{','.join(str(x) for x in row['cluster_indices'])}\t{row['cluster_group_size']}\t{row['group_assign_count']}\t{row['group_operator_count']}\t{row['group_input_signature_bits']}\t{row['owner_hint']}\t{row['topo_rank']}\t{row['topo_span']}\t{row['dominant_hierarchy']}\t{row['group_expr_kind_counts']}")
PY
)

if (( ${#SELECTED_LINES[@]} == 0 )); then
  echo "No clusters matched the requested filters" >&2
  exit 2
fi

printf 'cluster_indices\tcluster_group_size\tgroup_assign_count\tgroup_operator_count\tgroup_input_signature_bits\towner_hint\ttopo_rank\ttopo_span\tdominant_hierarchy\tgroup_expr_kind_counts\thybrid_gpu_ms_per_rep\thybrid_cpu_ms_per_rep\thybrid_speedup_gpu_over_cpu\thybrid_margin_ms\thybrid_setup_h2d_ms\thybrid_dynamic_h2d_ms_per_rep\thybrid_kernel_ms_per_rep\thybrid_d2h_ms_per_rep\thybrid_transfer_ms_per_rep\thybrid_cpu_dispatch_ms_per_rep\thybrid_static_h2d_bytes_per_batch\thybrid_dynamic_h2d_bytes_per_batch\thybrid_actual_h2d_bytes_per_batch\thybrid_actual_d2h_bytes_per_batch\thybrid_transfer_total_bytes_per_batch\tassigns_per_kib_transferred\toffload_score\toffload_worthy\thybrid_mismatch\tnvcc_compile_s\tbench_run_s\ttotal_elapsed_s\n' > "$SUMMARY_TSV"

echo "[3/3] Running cluster benches..."
for line in "${SELECTED_LINES[@]}"; do
  IFS=$'\t' read -r CLUSTER_INDICES GROUP_SIZE ASSIGN_COUNT OPERATOR_COUNT INPUT_BITS OWNER_HINT TOPO_RANK TOPO_SPAN DOM_HIER EXPR_KIND_COUNTS <<<"$line"
  CLUSTER_OUTDIR="$OUTDIR/cluster_${CLUSTER_INDICES//,/__}"
  BENCH_CMD=("$VERILATOR_BIN" --sim-accel-bench \
    --top-module "$TOP_MODULE" \
    --outdir "$CLUSTER_OUTDIR" \
    --nstates "$NSTATES" \
    --gpu-reps "$GPU_REPS" \
    --cpu-reps "$CPU_REPS" \
    --block-size "$BLOCK_SIZE" \
    --init-mode "$INIT_MODE" \
    --init-seed "$INIT_SEED" \
    --assigns-per-kernel "$ASSIGNS_PER_KERNEL")
  if [[ "$GROUP_SIZE" -eq 1 ]]; then
    BENCH_CMD+=(--hybrid-mode single-cluster --hybrid-cluster-index "${CLUSTER_INDICES%%,*}")
  else
    BENCH_CMD+=(--hybrid-mode cluster-group --hybrid-cluster-indices "$CLUSTER_INDICES")
  fi
  BENCH_CMD+=(
    --compile-cache-dir "$COMPILE_CACHE_DIR" \
    -- "${SOURCES[@]}")
  "${BENCH_CMD[@]}"

  python3 - "$CLUSTER_OUTDIR/bench_run.log" "$SUMMARY_TSV" "$CLUSTER_INDICES" "$GROUP_SIZE" "$ASSIGN_COUNT" "$OPERATOR_COUNT" \
    "$INPUT_BITS" "$OWNER_HINT" "$TOPO_RANK" "$TOPO_SPAN" "$DOM_HIER" "$EXPR_KIND_COUNTS" "$WORTHY_MIN_SPEEDUP" \
    "$WORTHY_MIN_MARGIN_MS" <<'PY'
import sys
log_path, out_tsv, cluster_indices, group_size, assign_count, operator_count, input_bits, owner_hint, topo_rank, topo_span, dom_hier, expr_kind_counts, worthy_min_speedup, worthy_min_margin_ms = sys.argv[1:15]
want = {
    'hybrid_gpu_ms_per_rep': '',
    'hybrid_cpu_ms_per_rep': '',
    'hybrid_setup_h2d_ms': '',
    'hybrid_dynamic_h2d_ms_per_rep': '',
    'hybrid_kernel_ms_per_rep': '',
    'hybrid_d2h_ms_per_rep': '',
    'hybrid_transfer_ms_per_rep': '',
    'hybrid_cpu_dispatch_ms_per_rep': '',
    'hybrid_static_h2d_bytes_per_batch': '',
    'hybrid_dynamic_h2d_bytes_per_batch': '',
    'hybrid_actual_h2d_bytes_per_batch': '',
    'hybrid_actual_d2h_bytes_per_batch': '',
    'hybrid_mismatch': '',
    'nvcc_compile_s': '',
    'bench_run_s': '',
    'total_elapsed_s': '',
}
with open(log_path, encoding='utf-8') as fh:
    for line in fh:
        line = line.strip()
        if '=' not in line:
            continue
        k, v = line.split('=', 1)
        if k in want:
            want[k] = v
gpu_ms = float(want['hybrid_gpu_ms_per_rep'] or 0.0)
cpu_ms = float(want['hybrid_cpu_ms_per_rep'] or 0.0)
static_h2d = int(want['hybrid_static_h2d_bytes_per_batch'] or 0)
dynamic_h2d = int(want['hybrid_dynamic_h2d_bytes_per_batch'] or 0)
actual_h2d = int(want['hybrid_actual_h2d_bytes_per_batch'] or 0)
actual_d2h = int(want['hybrid_actual_d2h_bytes_per_batch'] or 0)
transfer_total = actual_h2d + actual_d2h
assign_count_i = int(assign_count)
speedup = (cpu_ms / gpu_ms) if gpu_ms > 0.0 else 0.0
margin_ms = cpu_ms - gpu_ms
assigns_per_kib = (assign_count_i * 1024.0 / transfer_total) if transfer_total > 0 else 0.0
score = margin_ms * assigns_per_kib
offload_worthy = (
    want['hybrid_mismatch'] == '0'
    and speedup >= float(worthy_min_speedup)
    and margin_ms >= float(worthy_min_margin_ms)
)
with open(out_tsv, 'a', encoding='utf-8') as fh:
    fh.write('\t'.join([
        cluster_indices, group_size, assign_count, operator_count, input_bits, owner_hint, topo_rank, topo_span, dom_hier, expr_kind_counts,
        want['hybrid_gpu_ms_per_rep'], want['hybrid_cpu_ms_per_rep'],
        f"{speedup:.6f}", f"{margin_ms:.6f}",
        want['hybrid_setup_h2d_ms'], want['hybrid_dynamic_h2d_ms_per_rep'],
        want['hybrid_kernel_ms_per_rep'], want['hybrid_d2h_ms_per_rep'],
        want['hybrid_transfer_ms_per_rep'], want['hybrid_cpu_dispatch_ms_per_rep'],
        want['hybrid_static_h2d_bytes_per_batch'], want['hybrid_dynamic_h2d_bytes_per_batch'],
        want['hybrid_actual_h2d_bytes_per_batch'], want['hybrid_actual_d2h_bytes_per_batch'],
        str(transfer_total), f"{assigns_per_kib:.6f}", f"{score:.6f}",
        '1' if offload_worthy else '0',
        want['hybrid_mismatch'], want['nvcc_compile_s'], want['bench_run_s'],
        want['total_elapsed_s'],
    ]) + '\n')
PY

  if [[ "$KEEP_CLUSTER_OUTDIRS" -eq 0 ]]; then
    rm -rf "$CLUSTER_OUTDIR"
  fi
done

python3 - "$SUMMARY_TSV" "$SUMMARY_JSON" "$WORTHY_MIN_SPEEDUP" "$WORTHY_MIN_MARGIN_MS" <<'PY'
import csv
import json
import sys

tsv_path, json_path, worthy_min_speedup, worthy_min_margin_ms = sys.argv[1:5]
rows = list(csv.DictReader(open(tsv_path, newline=''), delimiter='\t'))
for row in rows:
    row['cluster_group_size'] = int(row['cluster_group_size'])
    row['group_assign_count'] = int(row['group_assign_count'])
    row['group_operator_count'] = int(row['group_operator_count'])
    row['group_input_signature_bits'] = int(row['group_input_signature_bits'])
    row['hybrid_gpu_ms_per_rep'] = float(row['hybrid_gpu_ms_per_rep'])
    row['hybrid_cpu_ms_per_rep'] = float(row['hybrid_cpu_ms_per_rep'])
    row['hybrid_speedup_gpu_over_cpu'] = float(row['hybrid_speedup_gpu_over_cpu'])
    row['hybrid_margin_ms'] = float(row['hybrid_margin_ms'])
    row['hybrid_setup_h2d_ms'] = float(row['hybrid_setup_h2d_ms'])
    row['hybrid_dynamic_h2d_ms_per_rep'] = float(row['hybrid_dynamic_h2d_ms_per_rep'])
    row['hybrid_kernel_ms_per_rep'] = float(row['hybrid_kernel_ms_per_rep'])
    row['hybrid_d2h_ms_per_rep'] = float(row['hybrid_d2h_ms_per_rep'])
    row['hybrid_transfer_ms_per_rep'] = float(row['hybrid_transfer_ms_per_rep'])
    row['hybrid_cpu_dispatch_ms_per_rep'] = float(row['hybrid_cpu_dispatch_ms_per_rep'])
    row['hybrid_actual_h2d_bytes_per_batch'] = int(row['hybrid_actual_h2d_bytes_per_batch'])
    row['hybrid_actual_d2h_bytes_per_batch'] = int(row['hybrid_actual_d2h_bytes_per_batch'])
    row['hybrid_transfer_total_bytes_per_batch'] = int(row['hybrid_transfer_total_bytes_per_batch'])
    row['assigns_per_kib_transferred'] = float(row['assigns_per_kib_transferred'])
    row['offload_score'] = float(row['offload_score'])
    row['offload_worthy'] = (row['offload_worthy'] == '1')
    row['hybrid_mismatch'] = int(row['hybrid_mismatch'])

rows_by_score = sorted(rows, key=lambda r: (r['offload_score'], r['hybrid_speedup_gpu_over_cpu']), reverse=True)
worthy = [r for r in rows_by_score if r['offload_worthy']]

payload = {
    'heuristic': {
        'worthy_min_speedup': float(worthy_min_speedup),
        'worthy_min_margin_ms': float(worthy_min_margin_ms),
        'score_definition': 'score = (cpu_ms - gpu_ms) * (assign_count / (transfer_total_bytes / 1024))',
    },
    'cluster_count': len(rows),
    'worthy_cluster_count': len(worthy),
    'worthy_cluster_indices': [r['cluster_indices'] for r in worthy],
    'top_clusters_by_score': rows_by_score[:10],
    'rows': rows,
}
with open(json_path, 'w', encoding='utf-8') as fh:
    json.dump(payload, fh, indent=2)
PY

echo "Wrote: $SUMMARY_TSV"
